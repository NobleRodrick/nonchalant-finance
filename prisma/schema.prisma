generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared platform layer
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id                 String                @id @default(uuid())
  name               String
  slug               String                @unique
  currency           String                @default("FCFA")
  timezone           String                @default("Africa/Douala")
  departments        Department[]
  users              User[]
  accounts           Account[]
  transactions       Transaction[]
  dailyStockRecords  DailyStockRecord[]
  stockItems         DepartmentStockItem[]
  stockMovements     StockMovement[]
  menuItems          MenuItem[]
  saleLines          SaleLine[]
  debts              Debt[]
  debtPayments       DebtPayment[]
  cashHandovers      CashHandover[]
  cashRequests       CashRequest[]
  recipeIngredients  RecipeIngredient[]
  dailyReports       DailyReport[]
  purchases          Purchase[]
  auditEvents        AuditEvent[]
  attachments        Attachment[]
  accountingPeriods  AccountingPeriod[]
  companies          Company[]
  inventorySnapshots InventorySnapshot[]
  debtors            Debtor[]
  notifications      Notification[]
  syncOperations     SyncOperation[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@map("organizations")
}

model Department {
  id                 String                @id @default(uuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  domain             DepartmentDomain      @default(RESTAURANT)
  code               String? // short code used in printed reference numbers, e.g. "RST"
  cashierDiscountLimit Int                 @default(0) // max discount (FCFA) a cashier may give per sale; 0 = not allowed
  openingCashFloat   Int                   @default(0) // cash in the drawer when the department started using the app
  isActive           Boolean               @default(true)
  debtors            Debtor[]
  documentSequences  DocumentSequence[]
  users              User[]                @relation("DepartmentUsers")
  memberships        UserDepartment[]
  accounts           Account[]
  transactions       Transaction[]
  dailyStockRecords  DailyStockRecord[]
  stockItems         DepartmentStockItem[]
  stockMovements     StockMovement[]
  menuItems          MenuItem[]
  saleLines          SaleLine[]
  debts              Debt[]
  debtPayments       DebtPayment[]
  cashHandovers      CashHandover[]
  cashRequests       CashRequest[]
  recipeIngredients  RecipeIngredient[]
  dailyReports       DailyReport[]
  purchases          Purchase[]
  attachments        Attachment[]
  inventorySnapshots InventorySnapshot[]
  venues             Venue[]
  venuePriceRules    VenuePriceRule[]
  venueClients       VenueClient[]
  venueBookings      VenueBooking[]
  venueCharges       VenueBookingCharge[]
  venuePackages      VenuePackage[]
  venueAssets        VenueAsset[]
  eventAssetChecks   EventAssetCheck[]
  assetIncidents     VenueAssetIncident[]
  venueLeads         VenueLead[]
  venueCashCounts    VenueCashCount[]
  rooms              Room[]
  roomBookings       RoomBooking[]
  roomAssets         RoomAsset[]
  roomAssetMoves     RoomAssetMovement[]
  roomRepairs        RoomRepair[]
  rentalItems        RentalItem[]
  rentalMovements    RentalMovement[]
  rentalOrders       RentalOrder[]
  rentalChecks       RentalCheck[]
  rentalIncidents    RentalIncident[]
  rentalCharges      RentalCharge[]
  fixedAssets        FixedAsset[]
  propertyBuildings  PropertyBuilding[]
  propertyUnits      PropertyUnit[]
  propertyLeases     PropertyLease[]
  // Business details printed on documents (quotations, invoices, receipts, contracts): legalName,
  // address, phone, email, website, taxId, logoId, contractTerms, paymentTerms, footer (lib/business-profile)
  profile            Json?
  // The registered company this department belongs to (set by the database to the business's
  // default company when not given; docs/ACCOUNTING_PLAN.md).
  companyId          String?
  company            Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tradeProducts      TradeProduct[]
  tradeMovements     TradeMovement[]
  tradeTabs          TradeTab[]
  tradePurchases     TradePurchase[]
  tradePackagings    TradePackaging[]
  serviceItems       ServiceItem[]
  serviceTickets     ServiceTicket[]
  serviceWorkers     ServiceWorker[]
  // Ledger kept up to date from this department's records (lib/accounting/sync.js).
  ledgerDirtyAt      DateTime?
  ledgerSyncedAt     DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([organizationId])
  @@map("departments")
}

model User {
  id                String                @id @default(uuid())
  organizationId    String?
  organization      Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId      String? // Primary/default department (mirror of the primary membership)
  department        Department?           @relation("DepartmentUsers", fields: [departmentId], references: [id], onDelete: SetNull)
  email             String                @unique
  passwordHash      String                @default("")
  name              String
  phone             String?
  imageUrl          String?
  role              UserRole              @default(HEAD)
  title             String? // job title given by the Boss (e.g. "Accountant", "Manager"); the role stays Department head
  isActive          Boolean               @default(true)
  // Sign-in security: bumping sessionVersion signs every session out at once; a temporary
  // password set by the Boss must be changed at the first sign-in; wrong passwords lock the
  // account for a while (shared by every server instance, unlike an in-memory counter).
  sessionVersion     Int       @default(0)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  memberships       UserDepartment[]
  transactions      Transaction[]
  accounts          Account[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  dailyStockRecords DailyStockRecord[]
  stockItems        DepartmentStockItem[]
  stockMovements    StockMovement[]
  menuItems         MenuItem[]
  saleLines         SaleLine[]
  debts             Debt[]
  debtPayments      DebtPayment[]
  cashHandovers     CashHandover[]
  cashRequests      CashRequest[]  @relation("CashRequestRequestedBy")
  recipeIngredients RecipeIngredient[]
  purchases         Purchase[]
  attachments       Attachment[]
  submittedReports  DailyReport[]         @relation("ReportSubmittedBy")
  reviewedReports   DailyReport[]         @relation("ReportReviewedBy")
  bookingsHandled   VenueBooking[]        @relation("BookingHandledBy")
  bookingsCreated   VenueBooking[]        @relation("BookingCreatedBy")
  leadsHandled      VenueLead[]           @relation("LeadHandledBy")
  assetChecks       EventAssetCheck[]     @relation("AssetCheckedBy")
  roomBookingsMade  RoomBooking[]         @relation("RoomBookingCreatedBy")
  expensesValidated Transaction[]         @relation("ExpenseValidatedBy")
  roomAssetMoves    RoomAssetMovement[]   @relation("RoomAssetMovedBy")
  roomRepairsMade   RoomRepair[]          @relation("RoomRepairCreatedBy")
  rentalOrdersMade  RentalOrder[]         @relation("RentalOrderCreatedBy")
  propertyLeases    PropertyLease[]       @relation("PropertyLeaseCreatedBy")
  rentalOrdersRun   RentalOrder[]         @relation("RentalOrderHandledBy")
  rentalMoves       RentalMovement[]      @relation("RentalMovedBy")
  rentalChecks      RentalCheck[]         @relation("RentalCheckedBy")
  rentalIncidents   RentalIncident[]      @relation("RentalIncidentBy")
  cashCounts        VenueCashCount[]      @relation("CashCountedBy")
  companyMemberships CompanyMember[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@map("users")
}

model UserDepartment {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isPrimary    Boolean    @default(false)
  isActive     Boolean    @default(true)
  // Rights the Boss gives this head in this department, beyond the daily work (lib/permissions
  // GRANTS): approve expenses, void / archive records, change prices, export.
  grants       String[]   @default(["APPROVE", "VOID", "PRICES", "EXPORT", "ARCHIVE"])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_departments")
}

/// Two roles: the Boss who created the business, and department heads (everyone the Boss adds;
/// they head every department they are assigned to). Job titles are free text (User.title).
enum UserRole {
  ADMIN // the Boss: oversees the business, manages departments and people
  HEAD // department head of one or more departments
  ACCOUNTANT // keeps the books of one or more companies (Full accounting); records no sales
}

enum DepartmentDomain {
  RESTAURANT
  EVENT_VENUE
  BAR
  PRESSING
  CAR_WASH
  ROOM_RENTAL
  MATERIAL_RENTAL
  PROPERTY_RENTAL
  SHOP
  OTHER
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique // SHA-256 of the refresh token (the token itself is only in the cookie)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AccountingPeriod {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String? // closes this company's departments only (none: the whole business)
  company        Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime // inclusive, start of business day (UTC instant)
  endDate        DateTime // inclusive, end of business day (UTC instant)
  status         AccountingPeriodStatus @default(OPEN)
  closedById     String?
  closedAt       DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, companyId, startDate])
  @@index([organizationId, startDate, endDate])
  @@map("accounting_periods")
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

/// Accounts are cash drawers / MoMo wallets / bank accounts held by a department.
model Account {
  id             String         @id @default(uuid())
  name           String
  type           AccountType
  balance        Decimal        @default(0)
  isDefault      Boolean        @default(false)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  cashHandovers  CashHandover[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@map("accounts")
}

/// Shared financial event header. `type` is the single accounting classifier;
/// `category`/`operationCategory` are descriptive sub-categories only.
model Transaction {
  id                String             @id @default(uuid())
  type              TransactionType
  amount            Decimal
  grossAmount       Decimal?
  discountAmount    Decimal?           @default(0)
  netAmount         Decimal?
  paymentMethod     PaymentMethod      @default(CASH)
  customerName      String?
  counterparty      String? // tenant / income source / supplier / payee
  reference         String? // external reference typed by the user (receipt no., MoMo id)
  referenceNo       String? // internal document number, e.g. "S-0142" (unique per department)
  operationCategory OperationCategory?
  description       String?
  date              DateTime           @default(now())
  category          String
  receiptUrl        String?
  receivedByName    String? // who received the money (venue payments), when not the person recording it
  bookingId         String? // venue booking this payment, refund or event expense belongs to
  booking           VenueBooking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  rentalOrderId     String? // event rental: the booking this payment, refund or event expense belongs to
  rentalOrder       RentalOrder?       @relation(fields: [rentalOrderId], references: [id], onDelete: SetNull)
  stayId            String? // rooms: the stay this payment or refund belongs to
  stay              RoomBooking?       @relation(fields: [stayId], references: [id], onDelete: SetNull)
  leaseId           String? // property rental: the contract a payment, deposit or refund belongs to
  lease             PropertyLease?     @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  propertyUnitId    String? // property rental: the office an expense or income belongs to
  propertyUnit      PropertyUnit?      @relation(fields: [propertyUnitId], references: [id], onDelete: SetNull)
  buildingId        String? // property rental: the building an expense belongs to
  building          PropertyBuilding?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  roomId            String? // rooms: the apartment an expense or income belongs to (none: shared by the house)
  room              Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  authorizedByName  String? // who authorized the expense (as stated when recording it)
  validatedById     String? // who checked the expense afterwards (the Boss or another head)
  validatedBy       User?              @relation("ExpenseValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt       DateTime?
  validationNote    String?
  status            TransactionStatus  @default(COMPLETED)
  voidedAt          DateTime?
  voidedById        String?
  voidReason        String?
  idempotencyKey    String?
  organizationId    String?
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String?
  account           Account?           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stockMovements    StockMovement[]
  saleLines         SaleLine[]
  debt              Debt?
  debtPayment       DebtPayment?
  cashHandovers     CashHandover[]
  purchase          Purchase?
  propertyAllocations PropertyAllocation[]
  propertyDeposit   PropertyDeposit?
  // VAT included in `amount` (Full accounting with VAT: typed on expenses, computed on income).
  taxAmount         Int?
  supplierId        String? // supplier of an expense, a bill line or a bill payment
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tradePurchaseId   String? // shop / bar: the purchase of goods this money out (or deposit paid) belongs to
  tradePurchase     TradePurchase?     @relation(fields: [tradePurchaseId], references: [id], onDelete: SetNull)
  serviceTicketId   String? // pressing / car wash: the ticket a payment, refund or compensation belongs to
  serviceTicket     ServiceTicket?     @relation(fields: [serviceTicketId], references: [id], onDelete: SetNull)
  serviceWorkerId   String? // car wash: the washer a commission payout goes to
  serviceWorker     ServiceWorker?     @relation(fields: [serviceWorkerId], references: [id], onDelete: SetNull)
  tradeLines        TradeSaleLine[]
  tradeTab          TradeTab?
  packagingMoves    PackagingMovement[]
  supplierBillId    String? // the supplier bill a line (expense on credit) or a payment belongs to
  supplierBill      SupplierBill?      @relation(fields: [supplierBillId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@unique([departmentId, referenceNo])
  @@index([organizationId])
  @@index([departmentId])
  @@index([departmentId, date])
  @@index([departmentId, type, date])
  @@index([userId])
  @@index([accountId])
  @@index([date])
  @@index([bookingId])
  @@index([stayId])
  @@index([rentalOrderId])
  @@index([roomId, date])
  @@index([leaseId])
  @@index([propertyUnitId, date])
  @@index([buildingId, date])
  @@index([supplierBillId])
  @@index([supplierId, date])
  @@index([tradePurchaseId])
  @@index([serviceTicketId])
  @@index([serviceWorkerId, date])
  @@map("transactions")
}

/// Legacy aggregate daily stock records (read-only history, superseded by stock movements).
model DailyStockRecord {
  id             String       @id @default(uuid())
  date           DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  openingStock   Decimal      @default(0)
  newPurchases   Decimal      @default(0)
  stockUsed      Decimal      @default(0)
  damagedStock   Decimal      @default(0)
  closingStock   Decimal      @default(0)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@index([userId])
  @@index([date])
  @@map("daily_stock_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// Restaurant inventory
// ─────────────────────────────────────────────────────────────────────────────

model DepartmentStockItem {
  id                 String              @id @default(uuid())
  name               String
  category           String?
  unit               String              @default("unit")
  trackingPeriod     StockTrackingPeriod @default(DAILY)
  openingQuantity    Decimal             @default(0)
  openingUnitCost    Decimal             @default(0)
  periodStart        DateTime?
  periodEnd          DateTime?
  currentQuantity    Decimal             @default(0)
  valuationUnitCost  Decimal             @default(0)
  reorderLevel       Decimal             @default(0)
  isActive           Boolean             @default(true)
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements          StockMovement[]
  recipeIngredients  RecipeIngredient[]
  purchaseLines      PurchaseLine[]
  inventorySnapshots InventorySnapshot[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([departmentId, name])
  @@index([organizationId])
  @@index([departmentId])
  @@map("department_stock_items")
}

/// Every change of plates in stock writes one movement (menuItemId). `quantity` is positive
/// for OPENING / STOCK_ADDED / SOLD / SPOILED and signed for CORRECTION /
/// OPENING_CORRECTION / REVERSAL. `balanceAfter` is the plates right after the movement.
/// stockItemId and the legacy types belong to the retired ingredient model (history only).
model StockMovement {
  id             String               @id @default(uuid())
  type           StockMovementType
  quantity       Decimal
  unitCost       Decimal?
  balanceAfter   Decimal?
  date           DateTime             @default(now())
  notes          String?
  reason         String?
  referenceNo    String? // "A-0012" stock added, "C-0003" correction / opening correction
  voidedAt       DateTime? // set on an addition that was voided (a REVERSAL movement compensates)
  purchaseId     String?
  purchase       Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  stockItemId    String?
  stockItem      DepartmentStockItem? @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem?            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  transactionId  String?
  transaction    Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())

  @@index([stockItemId, date])
  @@index([menuItemId, date])
  @@index([departmentId, date])
  @@map("stock_movements")
}

enum DishInventoryMode {
  DIRECT_PLATE
  RECIPE
}

/// A dish: one line of the menu AND one line of stock (plates). sellingPrice is the
/// "unit price"; currentQuantity caches the sum of the dish's stock movements.
model MenuItem {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  section            String?
  unit               String              @default("plate")
  sellingPrice       Decimal
  costPrice          Decimal             @default(0) // optional cost per plate (0 = unknown)
  inventoryMode      DishInventoryMode   @default(DIRECT_PLATE) // legacy; always DIRECT_PLATE
  openingQuantity    Decimal             @default(0) // legacy; opening is an OPENING movement
  currentQuantity    Decimal             @default(0)
  lowStockLevel      Int                 @default(0)
  sortOrder          Int                 @default(0)
  isActive           Boolean             @default(true)
  archivedAt         DateTime?
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe             RecipeIngredient[]
  saleLines          SaleLine[]
  purchaseLines      PurchaseLine[]
  movements          StockMovement[]
  inventorySnapshots InventorySnapshot[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([departmentId, name])
  @@index([organizationId, departmentId])
  @@map("menu_items")
}

model RecipeIngredient {
  id             String              @id @default(uuid())
  quantity       Decimal
  menuItemId     String
  menuItem       MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItemId    String
  stockItem      DepartmentStockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, stockItemId])
  @@index([departmentId])
  @@map("recipe_ingredients")
}

/// Sale line with price/cost snapshots so later menu edits never rewrite history.
model SaleLine {
  id             String            @id @default(uuid())
  quantity       Decimal
  unitPrice      Decimal
  totalAmount    Decimal // gross line value
  discountAmount Decimal           @default(0)
  netAmount      Decimal           @default(0)
  unitCost       Decimal           @default(0) // cost of one unit at time of sale (COGS)
  inventoryMode  DishInventoryMode @default(DIRECT_PLATE)
  transactionId  String
  transaction    Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@index([transactionId])
  @@index([menuItemId, createdAt])
  @@map("sale_lines")
}

model Purchase {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierName   String?
  reference      String?
  paymentMethod  PaymentMethod  @default(CASH)
  totalAmount    Decimal
  date           DateTime       @default(now())
  receiptUrl     String?
  notes          String?
  status         PurchaseStatus @default(RECORDED)
  transactionId  String?        @unique
  transaction    Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  lines          PurchaseLine[]
  stockAdds      StockMovement[] // plates this purchase added to dishes
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, departmentId, date])
  @@map("purchases")
}

enum PurchaseStatus {
  RECORDED
  VOIDED
}

model PurchaseLine {
  id          String               @id @default(uuid())
  purchaseId  String
  purchase    Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  description String? // what was bought, e.g. "Fish 10 kg"
  stockItemId String?
  stockItem   DepartmentStockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  menuItemId  String?
  menuItem    MenuItem?            @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  rentalItemId String?
  rentalItem  RentalItem?          @relation(fields: [rentalItemId], references: [id], onDelete: SetNull)
  quantity    Decimal
  unitCost    Decimal
  totalCost   Decimal
  createdAt   DateTime             @default(now())

  @@index([purchaseId])
  @@map("purchase_lines")
}

// ─────────────────────────────────────────────────────────────────────────────
// Receivables, cash handovers, reports, audit
// ─────────────────────────────────────────────────────────────────────────────

/// Money a customer owes the department. CREDIT_SALE / MANUAL debts come with a credit
/// sale (revenue on the day); OPENING_BALANCE debts existed before the app (no revenue).
model Debt {
  id              String        @id @default(uuid())
  source          DebtSource    @default(CREDIT_SALE)
  referenceNo     String? // "D-0007"
  debtorId        String?
  debtor          Debtor?       @relation(fields: [debtorId], references: [id], onDelete: SetNull)
  debtorName      String
  debtorContact   String?
  foodDescription String? // description of what was taken
  dueDate         DateTime?
  voidedAt        DateTime?
  voidReason      String?
  amountOwed      Decimal
  amountPaid      Decimal       @default(0)
  status          DebtStatus    @default(UNPAID)
  date            DateTime      @default(now())
  transactionId   String?       @unique
  transaction     Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments        DebtPayment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, departmentId, status])
  @@index([departmentId, date])
  @@index([debtorId])
  @@map("debts")
}

enum DebtSource {
  CREDIT_SALE
  MANUAL
  OPENING_BALANCE
}

/// Customer directory per department (people who take food on credit).
model Debtor {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  notes          String?
  isActive       Boolean      @default(true)
  debts          Debt[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([departmentId, name])
  @@map("debtors")
}

/// Counters for human-readable document numbers ("S-0142"), per department and type.
/// docType: S sale, P purchase, E expense, X other expense, R rent income, I other income,
/// K discount, D debt, Y debt repayment, H cash handover, A stock added, C stock correction,
/// DR daily report.
model DocumentSequence {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  docType      String
  nextValue    Int        @default(1)

  @@unique([departmentId, docType])
  @@map("document_sequences")
}

/// In-app notifications (Boss: report sent, handover recorded; head: report returned …).
model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId   String?
  kind           String
  title          String
  body           String?
  href           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model DebtPayment {
  id             String        @id @default(uuid())
  amount         Decimal
  paymentMethod  PaymentMethod @default(CASH)
  reference      String?
  date           DateTime      @default(now())
  voidedAt       DateTime?
  debtId         String
  debt           Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transactionId  String?       @unique
  transaction    Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([debtId, date])
  @@index([departmentId, date])
  @@map("debt_payments")
}

model CashHandover {
  id             String         @id @default(uuid())
  amount         Decimal
  recipientName  String         @default("CEO")
  referenceNo    String? // "H-0031"
  reference      String?
  receiptUrl     String?
  status         HandoverStatus @default(RECORDED)
  confirmedById  String?
  confirmedAt    DateTime?
  reviewNote     String?
  date           DateTime       @default(now())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String?
  account        Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactionId  String?
  transaction    Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  cashRequestId  String? // the Boss's request this handover answers
  cashRequest    CashRequest?   @relation(fields: [cashRequestId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@index([organizationId, departmentId, date])
  @@index([organizationId, status])
  @@map("cash_handovers")
}

/// The Boss asks a department to hand over the cash of a period (default: one day).
model CashRequest {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User              @relation("CashRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  fromKey        String // business days "YYYY-MM-DD", inclusive
  toKey          String
  note           String?
  status         CashRequestStatus @default(OPEN)
  answeredAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  handovers      CashHandover[]

  @@index([organizationId, status])
  @@index([departmentId, status])
  @@map("cash_requests")
}

enum CashRequestStatus {
  OPEN // waiting for the department head
  ANSWERED // the head handed cash over against it
  CANCELLED // withdrawn by the Boss
}

enum HandoverStatus {
  RECORDED // handed over by the department, awaiting the boss's confirmation
  CONFIRMED // boss confirmed receipt
  DISPUTED // boss disputes the amount (excluded from actual handover)
  VOIDED
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
  RETURNED
}

model DailyReport {
  id                 String              @id @default(uuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  reportDate         DateTime
  status             DailyReportStatus   @default(DRAFT)
  referenceNo        String? // "DR-0269"
  schemaVersion      Int                 @default(1) // snapshot layout version (2 = restaurant v2)
  version            Int                 @default(1)
  submittedById      String?
  submittedBy        User?               @relation("ReportSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById       String?
  reviewedBy         User?               @relation("ReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  snapshotJson       Json
  totalsJson         Json
  notes              String?
  reviewNotes        String?
  inventorySnapshots InventorySnapshot[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([departmentId, reportDate])
  @@index([organizationId, reportDate])
  @@index([organizationId, status])
  @@map("daily_reports")
}

/// Per-item closing position captured when a daily report is submitted.
model InventorySnapshot {
  id               String               @id @default(uuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId     String
  department       Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  dailyReportId    String
  dailyReport      DailyReport          @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  snapshotDate     DateTime
  itemType         InventoryItemType
  stockItemId      String?
  stockItem        DepartmentStockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  menuItemId       String?
  menuItem         MenuItem?            @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name             String
  unit             String
  openingQuantity  Decimal
  addedQuantity    Decimal
  usedQuantity     Decimal
  wastedQuantity   Decimal
  adjustedQuantity Decimal
  closingQuantity  Decimal
  unitCost         Decimal
  closingValue     Decimal
  createdAt        DateTime             @default(now())

  @@index([departmentId, snapshotDate])
  @@index([dailyReportId])
  @@map("inventory_snapshots")
}

enum InventoryItemType {
  STOCK_ITEM
  DISH
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  userId         String?
  action         String
  entityType     String
  entityId       String
  beforeJson     Json?
  afterJson      Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

/// Proof files (receipts, handover slips). Stored in the database so access is always
/// checked against organization/department membership.
model Attachment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  entityType     String?
  entityId       String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  data           Bytes
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
  @@map("attachments")
}


enum TransactionType {
  INCOME // legacy generic income (backfilled to OTHER_INCOME)
  EXPENSE
  SALE
  PURCHASE
  DISCOUNT
  RENT_INCOME
  OTHER_INCOME
  DEBT_PAYMENT
  OTHER_EXPENSE
  CASH_HANDOVER
  BOOKING_PAYMENT // money received from a client for a venue booking (an advance until the event)
  BOOKING_REFUND // money given back to a client of a venue booking
  SUPPLIER_PAYMENT // a supplier bill paid (the expense was counted on the bill's date)
}

enum PaymentMethod {
  CASH
  CREDIT
  MOMO
  BANK_TRANSFER
  OTHER // another method the business accepts (cheque, card …): say which in the reference
}

enum OperationCategory {
  PURCHASE_FOOD
  PURCHASE_DRINK
  PURCHASE_SUPPLIES
  PURCHASE_STOCK
  OPEX_UTILITIES
  OPEX_TRANSPORT
  OPEX_MAINTENANCE
  OPEX_SALARIES
  OPEX_OTHER
  SALE_FOOD
  SALE_DRINK
  SALE_SERVICES
  RENT_INCOME
  OTHER_INCOME
  OTHER_EXPENSE
  DISCOUNT_PROMO
  DISCOUNT_STAFF
  DISCOUNT_CUSTOMER
  CASH_HANDOVER
  DEBT_COLLECTION
}

enum AccountType {
  CURRENT
  SAVINGS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  VOIDED
}


enum StockTrackingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum StockMovementType {
  OPENING // plates when a dish is created
  PURCHASE // legacy (ingredient model)
  PREPARATION // legacy: prepared plates added to a dish
  USAGE // legacy: sold / consumed
  DAMAGE // legacy
  WASTE // legacy
  ADJUSTMENT // legacy: signed correction after a count
  REVERSAL // signed reversal of a voided sale / addition
  STOCK_ADDED // plates added (prepared / bought ready / received)
  SOLD // plates sold (sale)
  SPOILED // plates thrown away
  CORRECTION // signed correction after a physical count
  OPENING_CORRECTION // signed; dated at the start of a day; corrects that day's opening
}

enum DebtStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// One write sent by a device, online or later from its offline outbox (lib/sync). The key
/// (generated on the device) makes every operation idempotent: a retried or replayed operation
/// returns the result of its first run instead of recording anything twice. Written in the same
/// database transaction as the operation itself.
model SyncOperation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  userId         String
  key            String
  kind           String
  result         Json
  occurredAt     DateTime // when it was done on the device
  appliedAt      DateTime     @default(now())

  @@unique([organizationId, key])
  @@index([departmentId, appliedAt])
  @@map("sync_operations")
}

// ─── Event venue / banquet hall (docs/VENUE_RENTAL_PLAN.md) ──────────────────
// Amounts are whole FCFA. Dates of events, seasons and follow-ups are calendar dates (DATE),
// in the organization's time zone. Every row carries organizationId for tenant scoping.

/// A hall of an event venue department (one to start; ready for several).
model Venue {
  id                  String           @id @default(uuid())
  organizationId      String
  departmentId        String
  department          Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  capacity            Int? // guests
  basePrice           Int              @default(0) // price of a date when no rule applies
  reservationHoldDays Int              @default(7) // a reservation without deposit is held this many days
  isActive            Boolean          @default(true)
  priceRules          VenuePriceRule[]
  bookings            VenueBooking[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([departmentId, name])
  @@index([organizationId])
  @@map("venues")
}

enum VenuePriceRuleKind {
  WEEKDAY // a day of the week (0 = Sunday … 6 = Saturday)
  SEASON // a date range (e.g. December holidays)
  SPECIAL_DATE // one date (e.g. 31 December)
}

/// Price of a date: special date > season > weekday > the hall's base price.
model VenuePriceRule {
  id             String             @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  venueId        String
  venue          Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  kind           VenuePriceRuleKind
  label          String?
  weekday        Int?
  startDate      DateTime?          @db.Date
  endDate        DateTime?          @db.Date
  price          Int
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([venueId, kind])
  @@map("venue_price_rules")
}

model VenueClient {
  id             String         @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  phoneAlt       String?
  email          String?
  company        String?
  notes          String?
  address        String?
  bookings       VenueBooking[]
  rentalOrders   RentalOrder[]
  propertyLeases PropertyLease[]
  serviceTickets ServiceTicket[]
  identification String? // tenants: ID card, passport or company registration (as given)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([departmentId, name])
  @@index([organizationId])
  @@map("venue_clients")
}

enum VenueBookingStatus {
  RESERVED // the date is held (until holdUntil unless a deposit is paid)
  CONFIRMED
  COMPLETED // the event took place: its price is revenue of the event date
  CANCELLED // frees the date
}

/// One event on one date of a hall. No two active bookings share a hall and a date (a partial
/// unique index in the migration: status <> CANCELLED).
model VenueBooking {
  id              String               @id @default(uuid())
  organizationId  String
  departmentId    String
  department      Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  venueId         String
  venue           Venue                @relation(fields: [venueId], references: [id], onDelete: Restrict)
  clientId        String
  client          VenueClient          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  referenceNo     String // "B-0001"
  eventType       String
  eventDate       DateTime             @db.Date
  startTime       String? // "14:00" (information)
  endTime         String?
  guests          Int?
  status          VenueBookingStatus   @default(RESERVED)
  hallPrice       Int // price of the date from the price rules when booked
  packageId       String?
  package         VenuePackage?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageSnapshot Json? // the package as sold: name, price, items
  packagePrice    Int                  @default(0)
  agreedPrice     Int // total agreed with the client (hall + package)
  priceNote       String? // why the agreed price differs from hall + package
  holdUntil       DateTime?            @db.Date // reserved without deposit: held until this date
  bookedAt        DateTime             @default(now())
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?
  leadId          String?              @unique
  lead            VenueLead?           @relation("LeadBooking", fields: [leadId], references: [id], onDelete: SetNull)
  handledById     String?
  handledBy       User?                @relation("BookingHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User                 @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions    Transaction[]
  charges         VenueBookingCharge[]
  assetChecks     EventAssetCheck[]
  incidents       VenueAssetIncident[]
  roomBookings    RoomBooking[]        @relation("PackageRooms")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([departmentId, eventDate])
  @@index([departmentId, status, eventDate])
  @@index([organizationId, eventDate])
  @@index([clientId])
  @@map("venue_bookings")
}

enum VenueChargeKind {
  DAMAGE // damaged or missing assets charged to the client
  EXTRA_SERVICE
  OTHER
}

/// An amount added to what a client owes for a booking (damages, extra services).
model VenueBookingCharge {
  id             String              @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        VenueBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  referenceNo    String // "CH-0001"
  kind           VenueChargeKind
  label          String
  amount         Int
  date           DateTime            @default(now())
  createdById    String
  voidedAt       DateTime?
  voidReason     String?
  incident       VenueAssetIncident?
  createdAt      DateTime            @default(now())

  @@unique([departmentId, referenceNo])
  @@index([bookingId])
  @@index([departmentId, date])
  @@map("venue_booking_charges")
}

model VenuePackage {
  id             String             @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          Int // added to the hall price
  isActive       Boolean            @default(true)
  archivedAt     DateTime?
  items          VenuePackageItem[]
  bookings       VenueBooking[]
  leads          VenueLead[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([departmentId, isActive])
  @@map("venue_packages")
}

enum VenuePackageItemKind {
  ROOM // rooms of a rooms department (e.g. Executive Stay): quantity rooms × nights
  SERVICE // decoration, sound, catering …
  OTHER
}

model VenuePackageItem {
  id        String               @id @default(uuid())
  packageId String
  package   VenuePackage         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  kind      VenuePackageItemKind
  label     String
  quantity  Int                  @default(1)
  nights    Int?
  sortOrder Int                  @default(0)

  @@index([packageId])
  @@map("venue_package_items")
}

enum VenueAssetCategory {
  CHAIRS
  TABLES
  DECORATION
  SOUND
  LIGHTING
  FURNITURE
  OTHER
}

/// Hall inventory checked before and after every event.
model VenueAsset {
  id             String                @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  category       VenueAssetCategory
  quantity       Int // owned, in good condition or not
  unitValue      Int                   @default(0) // replacement value of one unit
  notes          String?
  isActive       Boolean               @default(true)
  checkLines     EventAssetCheckLine[]
  incidents      VenueAssetIncident[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([departmentId, name])
  @@index([organizationId])
  @@map("venue_assets")
}

enum EventCheckPhase {
  BEFORE
  AFTER
}

model EventAssetCheck {
  id             String                @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        VenueBooking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  phase          EventCheckPhase
  checkedById    String
  checkedBy      User                  @relation("AssetCheckedBy", fields: [checkedById], references: [id], onDelete: Restrict)
  checkedAt      DateTime              @default(now())
  notes          String?
  lines          EventAssetCheckLine[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([bookingId, phase])
  @@index([departmentId, checkedAt])
  @@map("event_asset_checks")
}

/// Per asset: units present in good condition, damaged, missing (good + damaged + missing = expected).
model EventAssetCheckLine {
  id       String          @id @default(uuid())
  checkId  String
  check    EventAssetCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  assetId  String
  asset    VenueAsset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  expected Int
  good     Int
  damaged  Int             @default(0)
  missing  Int             @default(0)
  note     String?

  @@unique([checkId, assetId])
  @@map("event_asset_check_lines")
}

enum AssetIncidentKind {
  DAMAGED
  MISSING
}

enum AssetResponsibility {
  CLIENT
  STAFF
  UNKNOWN
}

enum AssetIncidentStatus {
  OPEN // found after the event, not settled yet
  CHARGED // charged to the client (a booking charge)
  LOSS // recorded as a loss of the hall
  RESOLVED // repaired / found / replaced at no cost
}

/// A difference found after an event (damaged or missing units) and how it was settled.
model VenueAssetIncident {
  id             String              @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        VenueBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assetId        String
  asset          VenueAsset          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  kind           AssetIncidentKind
  quantity       Int
  cost           Int                 @default(0) // estimated cost (repair or replacement)
  responsibility AssetResponsibility @default(UNKNOWN)
  status         AssetIncidentStatus @default(OPEN)
  chargeId       String?             @unique
  charge         VenueBookingCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  note           String?
  settledAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([departmentId, status])
  @@index([bookingId])
  @@map("venue_asset_incidents")
}

enum VenueLeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  NEGOTIATING
  BOOKED
  LOST
  CANCELLED
}

/// An enquiry that is not (yet) a booking.
model VenueLead {
  id             String          @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  clientName     String
  phone          String?
  email          String?
  enquiryDate    DateTime        @db.Date
  proposedDate   DateTime?       @db.Date
  eventType      String?
  guests         Int?
  packageId      String?
  package        VenuePackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  priceDiscussed Int?
  source         String?
  handledById    String?
  handledBy      User?           @relation("LeadHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  followUpDate   DateTime?       @db.Date
  status         VenueLeadStatus @default(NEW)
  closedReason   String? // why it was lost or cancelled
  closedAt       DateTime?
  notes          String?
  booking        VenueBooking?   @relation("LeadBooking")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([departmentId, status])
  @@index([departmentId, followUpDate])
  @@index([departmentId, enquiryDate])
  @@map("venue_leads")
}

/// The cash counted in an event venue's drawer on a day, against what it should hold (the
/// difference is a discrepancy shown in the reports and to the Boss). One count per day; a
/// later count of the same day replaces it.
model VenueCashCount {
  id             String     @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  date           DateTime   @db.Date
  countedCash    Int
  expectedCash   Int // what the drawer should hold at the count (opening + cash in − cash out − handed over)
  variance       Int // counted − expected (negative: cash missing)
  notes          String?
  countedById    String
  countedBy      User       @relation("CashCountedBy", fields: [countedById], references: [id], onDelete: Restrict)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([departmentId, date])
  @@index([organizationId, date])
  @@map("venue_cash_counts")
}

// ─── Rooms / guest house (e.g. Executive Stay) ───────────────────────────────

/// A room of a rooms department.
model Room {
  id             String        @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String // number or name, e.g. "101" or "Executive suite 2"
  roomType       String?
  capacity       Int?
  nightlyRate    Int           @default(0)
  weeklyRate     Int? // suggested price of 7 nights (prices stay editable on each booking)
  monthlyRate    Int? // suggested price of 30 nights
  description    String?
  state          RoomState     @default(AVAILABLE) // set by the head; reserved / occupied come from the bookings
  stateNote      String?
  notes          String?
  isActive       Boolean       @default(true)
  bookings       RoomBooking[]
  transactions   Transaction[]
  assets         RoomAsset[]
  repairs        RoomRepair[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([departmentId, name])
  @@index([organizationId])
  @@map("rooms")
}

enum RoomState {
  AVAILABLE
  MAINTENANCE
  UNAVAILABLE
}

enum RoomBookingStatus {
  RESERVED
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

/// A stay in a room: nights from checkIn (included) to checkOut (excluded). No two stays of a
/// room overlap (checked under a lock per room). A free room of a venue package is a stay with
/// complimentary = true and the venue booking it comes from.
model RoomBooking {
  id                    String            @id @default(uuid())
  organizationId        String
  departmentId          String
  department            Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roomId                String
  room                  Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  referenceNo           String // "RB-0001"
  guestName             String
  guestPhone            String?
  guestEmail            String?
  guestCount            Int?
  bookingType           String            @default("NIGHT") // NIGHT | WEEK | MONTH | OTHER (how it was priced)
  priceNote             String? // why the price differs from the apartment's rate
  checkedInAt           DateTime?
  checkedOutAt          DateTime?
  checkIn               DateTime          @db.Date
  checkOut              DateTime          @db.Date
  status                RoomBookingStatus @default(CONFIRMED)
  nightlyRate           Int               @default(0)
  totalPrice            Int               @default(0)
  complimentary         Boolean           @default(false)
  sourceVenueBookingId  String?
  sourceVenueBooking    VenueBooking?     @relation("PackageRooms", fields: [sourceVenueBookingId], references: [id], onDelete: SetNull)
  notes                 String?
  cancelledAt           DateTime?
  cancelReason          String?
  createdById           String
  createdBy             User              @relation("RoomBookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions          Transaction[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([roomId, checkIn])
  @@index([departmentId, checkIn])
  @@index([sourceVenueBookingId])
  @@map("room_bookings")
}

/// An asset of a rooms department: a line per apartment (roomId) or in storage (no room). `damaged`
/// of the `quantity` units are damaged. Values are purchase values (no depreciation, owner's decision).
model RoomAsset {
  id             String              @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  name           String
  category       String // BED, MATTRESS, TV, FRIDGE, AC, CHAIR, TABLE, CURTAINS, KITCHEN, BATHROOM, FURNITURE, OTHER
  quantity       Int
  damaged        Int                 @default(0)
  unitValue      Int                 @default(0)
  notes          String?
  movements      RoomAssetMovement[]
  repairs        RoomRepair[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([departmentId, roomId])
  @@map("room_assets")
}

enum RoomAssetMovementKind {
  BOUGHT
  TRANSFER_OUT
  TRANSFER_IN
  DAMAGED
  MISSING
  REPAIRED
  REPLACED
  REMOVED
}

/// What happened to an asset line (each movement changes its counts in the same transaction).
/// `loss` is the value that left the register (missing, removed, replaced units).
model RoomAssetMovement {
  id             String                @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assetId        String
  asset          RoomAsset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  referenceNo    String // "AM-0001"
  kind           RoomAssetMovementKind
  quantity       Int
  value          Int                   @default(0) // value bought / moved
  loss           Int                   @default(0)
  cost           Int                   @default(0) // money spent (purchase, repair)
  otherRoomId    String? // transfer: the apartment on the other side
  transactionId  String? // when paid from the cash drawer
  note           String?
  date           DateTime
  createdById    String
  createdBy      User                  @relation("RoomAssetMovedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime              @default(now())

  @@unique([departmentId, referenceNo])
  @@index([departmentId, date])
  @@index([assetId])
  @@map("room_asset_movements")
}

enum RepairPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RepairStatus {
  REPORTED
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Something to fix in an apartment. Its actual cost, when paid from the cash drawer, is an
/// expense of the apartment (transactionId).
model RoomRepair {
  id             String         @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assetId        String?
  asset          RoomAsset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  referenceNo    String // "MR-0001"
  title          String
  description    String?
  reportedOn     DateTime       @db.Date
  priority       RepairPriority @default(NORMAL)
  status         RepairStatus   @default(REPORTED)
  estimatedCost  Int?
  actualCost     Int?
  responsibleName String?
  repairedOn     DateTime?      @db.Date
  transactionId  String?
  blocksRoom     Boolean        @default(false) // the apartment cannot be let until it is repaired
  cancelReason   String?
  createdById    String
  createdBy      User           @relation("RoomRepairCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([departmentId, status])
  @@index([roomId])
  @@map("room_repairs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Event & decoration rental (MATERIAL_RENTAL departments, e.g. Deco Diva):
// docs/EVENT_RENTAL_PLAN.md
// ─────────────────────────────────────────────────────────────────────────────

enum ItemCondition {
  NEW
  GOOD
  FAIR
  WORN
}

/// A stock line of rental items (Chairs, Gold charger plates …). Quantities are never typed:
/// every change is a movement and the counters below always equal the sum of its movements.
///   in stock = owned − out − damaged − inRepair − missing
model RentalItem {
  id               String           @id @default(uuid())
  organizationId   String
  departmentId     String
  department       Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code             String // "CHR-001"
  name             String
  category         String
  description      String?
  unit             String           @default("piece")
  rentalPrice      Int              @default(0) // per event
  purchasePrice    Int              @default(0) // last unit cost
  replacementValue Int              @default(0) // charged for a lost unit (0: the purchase price)
  purchasedOn      DateTime?        @db.Date
  supplier         String?
  condition        ItemCondition    @default(GOOD)
  location         String?
  photoId          String? // attachment
  lowStockLevel    Int              @default(0)
  owned            Int              @default(0)
  out              Int              @default(0)
  damaged          Int              @default(0)
  inRepair         Int              @default(0)
  missing          Int              @default(0)
  isActive         Boolean          @default(true)
  archivedAt       DateTime?
  archiveReason    String?
  movements        RentalMovement[]
  orderLines       RentalOrderLine[]
  checkLines       RentalCheckLine[]
  incidents        RentalIncident[]
  purchaseLines    PurchaseLine[]
  assets           FixedAsset[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([departmentId, code])
  @@index([departmentId, isActive, category])
  @@map("rental_items")
}

enum RentalMovementKind {
  OPENING // counted when the department started
  PURCHASED
  ISSUED // out to an event
  RETURNED // back in good condition
  DAMAGED
  REPAIR_SENT
  REPAIRED
  MISSING
  FOUND
  WRITTEN_OFF // thrown away, sold, lost for good: leaves the stock
  ADJUSTED // a counted correction (reason required)
  TRANSFERRED // moved to another storage place (quantities unchanged)
}

/// One change of a stock line; the d* columns are the changes of its counters.
model RentalMovement {
  id             String             @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  itemId         String
  item           RentalItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  referenceNo    String // "SM-0001"
  kind           RentalMovementKind
  quantity       Int
  dOwned         Int                @default(0)
  dOut           Int                @default(0)
  dDamaged       Int                @default(0)
  dRepair        Int                @default(0)
  dMissing       Int                @default(0)
  value          Int                @default(0) // cost of a purchase, a loss, a repair
  orderId        String?
  order          RentalOrder?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseId     String?
  incidentId     String?
  fromLocation   String?
  toLocation     String?
  note           String?
  date           DateTime
  createdById    String
  createdBy      User               @relation("RentalMovedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())

  @@unique([departmentId, referenceNo])
  @@index([itemId, date])
  @@index([departmentId, date])
  @@index([orderId])
  @@map("rental_movements")
}

enum RentalOrderStatus {
  INQUIRY
  QUOTED // quotation sent
  CONFIRMED // holds its items from dispatch to return
  PREPARING
  DISPATCHED // items out
  RETURNED // items back (differences settled or flagged)
  CLOSED // done (money settled or written down)
  CANCELLED
}

/// A booking (an event): customer, event, items and services, dispatch → return.
model RentalOrder {
  id                  String            @id @default(uuid())
  organizationId      String
  departmentId        String
  department          Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  referenceNo         String // "B-0001"
  clientId            String
  client              VenueClient       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  eventType           String
  eventDate           DateTime          @db.Date
  eventLocation       String?
  dispatchDate        DateTime          @db.Date
  returnDate          DateTime          @db.Date
  guests              Int?
  status              RentalOrderStatus @default(INQUIRY)
  itemsTotal          Int               @default(0)
  servicesTotal       Int               @default(0)
  discount            Int               @default(0)
  agreedPrice         Int               @default(0) // items + services − discount
  priceNote           String?
  depositDue          Int               @default(0)
  paymentDueDate      DateTime?         @db.Date
  specialInstructions String?
  notes               String?
  staffNames          String[]          @default([])
  handledById         String?
  handledBy           User?             @relation("RentalOrderHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User              @relation("RentalOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  quotedAt            DateTime?
  confirmedAt         DateTime?
  preparingAt         DateTime?
  dispatchedAt        DateTime?
  returnedAt          DateTime?
  closedAt            DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  lines               RentalOrderLine[]
  checks              RentalCheck[]
  incidents           RentalIncident[]
  charges             RentalCharge[]
  movements           RentalMovement[]
  transactions        Transaction[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([departmentId, eventDate])
  @@index([departmentId, status, dispatchDate])
  @@index([departmentId, returnDate])
  @@index([clientId])
  @@map("rental_orders")
}

enum RentalLineKind {
  ITEM
  SERVICE // decoration work, transport, labour …
}

model RentalOrderLine {
  id        String            @id @default(uuid())
  orderId   String
  order     RentalOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      RentalLineKind    @default(ITEM)
  itemId    String?
  item      RentalItem?       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  label     String
  quantity  Int
  listPrice Int               @default(0) // the item's rental price when booked
  unitPrice Int
  total     Int
  sortOrder Int               @default(0)
  issued    Int               @default(0)
  returned  Int               @default(0) // back in good condition
  damaged   Int               @default(0)
  broken    Int               @default(0)
  missing   Int               @default(0)
  checkLines RentalCheckLine[]

  @@index([orderId])
  @@index([itemId])
  @@map("rental_order_lines")
}

enum RentalCheckKind {
  DISPATCH
  RETURN
}

/// Items handed out for an event, or (one or several) returns.
model RentalCheck {
  id             String            @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  orderId        String
  order          RentalOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  referenceNo    String // "DN-0001" (dispatch note) / "GR-0001" (goods returned)
  kind           RentalCheckKind
  date           DateTime
  counterpart    String? // who took the items / who brought them back
  notes          String?
  checkedById    String
  checkedBy      User              @relation("RentalCheckedBy", fields: [checkedById], references: [id], onDelete: Restrict)
  lines          RentalCheckLine[]
  createdAt      DateTime          @default(now())

  @@unique([departmentId, referenceNo])
  @@index([orderId])
  @@index([departmentId, date])
  @@map("rental_checks")
}

model RentalCheckLine {
  id       String          @id @default(uuid())
  checkId  String
  check    RentalCheck     @relation(fields: [checkId], references: [id], onDelete: Cascade)
  lineId   String
  line     RentalOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  itemId   String
  item     RentalItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity Int // issued (dispatch) or back in good condition (return)
  damaged  Int             @default(0)
  broken   Int             @default(0)
  missing  Int             @default(0)

  @@index([checkId])
  @@map("rental_check_lines")
}

enum RentalIncidentKind {
  DAMAGED // can be repaired
  BROKEN // beyond repair
  MISSING
}

enum RentalIncidentStatus {
  OPEN // flagged, not decided yet
  CHARGED // charged to the customer
  LOSS // a loss of the business
  REPAIR // sent to repair
  RESOLVED // repaired, or found
}

/// Damaged, broken or missing items (after an event or in storage) and how they were settled.
model RentalIncident {
  id              String               @id @default(uuid())
  organizationId  String
  departmentId    String
  department      Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  referenceNo     String // "IN-0001"
  itemId          String
  item            RentalItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  orderId         String?
  order           RentalOrder?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kind            RentalIncidentKind
  quantity        Int
  reason          String?
  responsibleName String?
  estimatedLoss   Int                  @default(0) // quantity × replacement value
  repairCost      Int                  @default(0)
  chargedAmount   Int                  @default(0)
  status          RentalIncidentStatus @default(OPEN)
  chargeId        String?              @unique
  charge          RentalCharge?        @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  repairBy        String?
  stockAction     String? // what became of the units: REPAIR (sent to repair), WRITE_OFF, FOUND
  repairedAt      DateTime?
  note            String?
  date            DateTime
  settledAt       DateTime?
  createdById     String
  createdBy       User                 @relation("RentalIncidentBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([departmentId, status])
  @@index([orderId])
  @@index([itemId])
  @@map("rental_incidents")
}

enum RentalChargeKind {
  DAMAGE
  EXTRA_DAYS
  TRANSPORT
  LABOUR
  OTHER
}

/// An amount added to what a customer owes for a booking.
model RentalCharge {
  id             String           @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  orderId        String
  order          RentalOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  referenceNo    String // "CH-0001"
  kind           RentalChargeKind
  label          String
  amount         Int
  date           DateTime
  createdById    String
  voidedAt       DateTime?
  voidReason     String?
  incident       RentalIncident?
  createdAt      DateTime         @default(now())

  @@unique([departmentId, referenceNo])
  @@index([orderId])
  @@index([departmentId, date])
  @@map("rental_charges")
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

/// The asset register (any department): long-term items whose cost is spread over their life.
model FixedAsset {
  id               String             @id @default(uuid())
  organizationId   String
  departmentId     String
  department       Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code             String // "AS-0001"
  name             String
  category         String
  rentalItemId     String?
  rentalItem       RentalItem?        @relation(fields: [rentalItemId], references: [id], onDelete: SetNull)
  quantity         Int                @default(1)
  purchaseDate     DateTime           @db.Date
  cost             Int // total purchase cost
  supplier         String?
  usefulLifeMonths Int
  salvageValue     Int                @default(0)
  method           DepreciationMethod @default(STRAIGHT_LINE)
  condition        ItemCondition      @default(GOOD)
  location         String?
  responsibleName  String?
  notes            String?
  purchaseId       String?
  disposedOn       DateTime?          @db.Date
  disposalReason   String?
  disposalValue    Int                @default(0) // money received when sold
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([departmentId, code])
  @@index([departmentId, disposedOn])
  @@map("fixed_assets")
}


// ─── Office & property rental (PROPERTY_RENTAL, e.g. Place Étoilée & Main Building) ──────────
// docs/PROPERTY_RENTAL_PLAN.md. Rent is never stored as a bill: the schedule of a contract is
// computed (lib/property/rent-schedule.js); payments, deposit uses and waivers are allocated to
// its months and to the charges below.

/// Set by the managers; "occupied" and "reserved" come from the contracts.
enum PropertyUnitState {
  AVAILABLE
  MAINTENANCE
  UNAVAILABLE
  AWAITING_HANDOVER
}

enum PropertyChargeKind {
  ELECTRICITY
  WATER
  INTERNET
  CLEANING
  SECURITY
  WASTE
  MAINTENANCE
  DAMAGE
  LATE_FEE
  OTHER
}

/// How an office's utility or charge is billed: meter readings × rate, a fixed amount a month,
/// a share (%) of the building's bill, or included in the rent (not billed).
enum PropertyBillingMethod {
  METER
  FIXED
  SHARE
  INCLUDED
}

enum PropertyLeaseStatus {
  RESERVED
  ACTIVE
  ENDED
  CANCELLED
}

enum PropertyDepositKind {
  RECEIVED
  REFUNDED
  APPLIED_RENT
  APPLIED_CHARGES
  APPLIED_DAMAGE
}

enum PropertyMaintenanceStatus {
  REPORTED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PropertyInspectionKind {
  MOVE_IN
  MOVE_OUT
  DAMAGE
  MAINTENANCE
  ROUTINE
}

model PropertyBuilding {
  id             String         @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  notes          String?
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  units          PropertyUnit[]
  transactions   Transaction[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([departmentId, name])
  @@map("property_buildings")
}

model PropertyUnit {
  id              String                @id @default(uuid())
  organizationId  String
  departmentId    String
  department      Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  buildingId      String
  building        PropertyBuilding      @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  name            String // "A12", "Office 01"
  floor           String?
  category        String? // single office, open space, shop, suite …
  size            Float? // m²
  listRent        Int                   @default(0) // current monthly rent offered (history in property_rates)
  depositRequired Int                   @default(0)
  condition       String? // GOOD | FAIR | NEEDS_REPAIR
  state           PropertyUnitState     @default(AVAILABLE)
  stateNote       String?
  availableFrom   DateTime?             @db.Date
  description     String?
  notes           String?
  isActive        Boolean               @default(true)
  archivedAt      DateTime?
  chargeSettings  PropertyUnitCharge[]
  rates           PropertyRate[]
  leases          PropertyLease[]
  charges         PropertyCharge[]
  maintenance     PropertyMaintenance[]
  inspections     PropertyInspection[]
  transactions    Transaction[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([buildingId, name])
  @@index([departmentId, isActive])
  @@map("property_units")
}

model PropertyUnitCharge {
  id          String                @id @default(uuid())
  unitId      String
  unit        PropertyUnit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  kind        PropertyChargeKind
  label       String? // for OTHER (e.g. "Parking")
  method      PropertyBillingMethod
  rate        Float                 @default(0) // per unit (meter), FCFA a month (fixed), % (share)
  meterNumber String?
  lastReading Float? // last meter reading billed
  note        String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([unitId])
  @@map("property_unit_charges")
}

/// Price history: the list rent of an office, or the rent of a contract, from a month on.
model PropertyRate {
  id           String         @id @default(uuid())
  departmentId String
  unitId       String?
  unit         PropertyUnit?  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  leaseId      String?
  lease        PropertyLease? @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  amount       Int
  fromMonth    String // "2027-01"
  note         String?
  createdById  String
  createdAt    DateTime       @default(now())

  @@index([unitId, fromMonth])
  @@index([leaseId, fromMonth])
  @@map("property_rates")
}

model PropertyLease {
  id              String                @id @default(uuid())
  organizationId  String
  departmentId    String
  department      Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  referenceNo     String // "LC-0001"
  unitId          String
  unit            PropertyUnit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  clientId        String
  client          VenueClient           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status          PropertyLeaseStatus   @default(RESERVED)
  startDate       DateTime              @db.Date // rent runs from this day
  endDate         DateTime?             @db.Date // contract expiry (none: open-ended)
  moveInDate      DateTime?             @db.Date
  moveOutDate     DateTime?             @db.Date // last day billed
  rent            Int // monthly rent at the start (changes in property_rates)
  dueDay          Int                   @default(5)
  monthsPerBill   Int                   @default(1) // 1, 3, 6 or 12
  depositRequired Int                   @default(0)
  noticeDays      Int                   @default(30)
  utilities       String? // who pays what, as agreed
  conditions      String?
  notes           String?
  createdById     String
  createdBy       User                  @relation("PropertyLeaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  startedAt       DateTime?
  endedAt         DateTime?
  endReason       String?
  cancelledAt     DateTime?
  cancelReason    String?
  settlement      Json? // move-out summary (balances, deposit decision, inspection)
  rates           PropertyRate[]
  charges         PropertyCharge[]
  allocations     PropertyAllocation[]
  deposits        PropertyDeposit[]
  maintenance     PropertyMaintenance[]
  inspections     PropertyInspection[]
  transactions    Transaction[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([unitId, status])
  @@index([clientId])
  @@index([departmentId, status])
  @@map("property_leases")
}

/// Everything billed to a tenant other than rent: utilities (with meter readings), cleaning,
/// damages, late fees … Voided with a reason, never deleted.
model PropertyCharge {
  id              String               @id @default(uuid())
  organizationId  String
  departmentId    String
  referenceNo     String // "UB-0001"
  leaseId         String
  lease           PropertyLease        @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  unitId          String
  unit            PropertyUnit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  kind            PropertyChargeKind
  label           String
  monthKey        String // the month it belongs to, "2026-11"
  date            DateTime // billed on
  dueDate         DateTime             @db.Date
  amount          Int
  previousReading Float?
  currentReading  Float?
  units           Float?
  rate            Float?
  note            String?
  maintenanceId   String?
  inspectionId    String?
  createdById     String
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  allocations     PropertyAllocation[]
  createdAt       DateTime             @default(now())

  @@unique([departmentId, referenceNo])
  @@index([leaseId, monthKey])
  @@index([departmentId, date])
  @@map("property_charges")
}

/// What paid what: a payment, a deposit use or a waiver, for a month's rent or a charge.
model PropertyAllocation {
  id            String           @id @default(uuid())
  departmentId  String
  leaseId       String
  lease         PropertyLease    @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  monthKey      String? // rent of that month
  chargeId      String?
  charge        PropertyCharge?  @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  amount        Int
  source        String // PAYMENT | DEPOSIT | WAIVER
  transactionId String?
  transaction   Transaction?     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  depositId     String?
  deposit       PropertyDeposit? @relation(fields: [depositId], references: [id], onDelete: Restrict)
  note          String?
  date          DateTime
  createdById   String
  voidedAt      DateTime?
  createdAt     DateTime         @default(now())

  @@index([leaseId])
  @@index([transactionId])
  @@index([chargeId])
  @@map("property_allocations")
}

/// The deposit (caution) ledger of a contract: money held for the tenant, never income.
model PropertyDeposit {
  id             String               @id @default(uuid())
  organizationId String
  departmentId   String
  leaseId        String
  lease          PropertyLease        @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  kind           PropertyDepositKind
  amount         Int
  date           DateTime
  transactionId  String?              @unique
  transaction    Transaction?         @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  note           String?
  createdById    String
  voidedAt       DateTime?
  allocations    PropertyAllocation[]
  createdAt      DateTime             @default(now())

  @@index([leaseId])
  @@index([departmentId, date])
  @@map("property_deposits")
}

model PropertyMaintenance {
  id             String                    @id @default(uuid())
  organizationId String
  departmentId   String
  referenceNo    String // "MR-0001"
  unitId         String
  unit           PropertyUnit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  leaseId        String?
  lease          PropertyLease?            @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  title          String // the problem
  description    String?
  priority       String                    @default("NORMAL") // LOW | NORMAL | URGENT
  reportedAt     DateTime
  reportedBy     String?
  assignedTo     String?
  scheduledFor   DateTime? // appointment
  status         PropertyMaintenanceStatus @default(REPORTED)
  cost           Int                       @default(0)
  technician     String?
  approvedById   String?
  approvedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelReason   String?
  transactionId  String? // the expense that paid it
  notes          String?
  createdById    String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([unitId])
  @@index([departmentId, status])
  @@map("property_maintenance")
}

model PropertyInspection {
  id             String                 @id @default(uuid())
  organizationId String
  departmentId   String
  referenceNo    String // "IS-0001"
  unitId         String
  unit           PropertyUnit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  leaseId        String?
  lease          PropertyLease?         @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  maintenanceId  String?
  kind           PropertyInspectionKind
  scheduledFor   DateTime?              @db.Date
  doneAt         DateTime?
  inspector      String?
  condition      String? // GOOD | FAIR | NEEDS_REPAIR
  rows           Json? // list of area, condition, note
  damageCost     Int                    @default(0)
  notes          String?
  createdById    String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([unitId])
  @@index([departmentId, scheduledFor])
  @@map("property_inspections")
}


// ─── Accounting (companies, SYSCOHADA ledger) ──────────────────────────────────────────────
// docs/ACCOUNTING_PLAN.md. The ledger is generated from the money records and revenue
// recognitions by posting rules (lib/accounting); entries are never edited, only reversed.

enum AccountingLevel {
  SIMPLE // money in / out, cash, debts, profit (Système minimal de trésorerie)
  FULL // SYSCOHADA double-entry accounting (Système normal)
}

enum JournalKind {
  SALES
  PURCHASES
  CASH
  BANK
  MOBILE_MONEY
  GENERAL
  OPENING
}

enum JournalEntryStatus {
  DRAFT
  PENDING // a manual entry waiting for approval
  POSTED
  REJECTED
}

enum SupplierBillStatus {
  OPEN
  PARTIAL
  PAID
  VOIDED
}

enum StatementLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

/// A registered company (NIU, RCCM): it owns departments, keeps its own books and files its taxes.
model Company {
  id                    String          @id @default(uuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  legalName             String?
  taxId                 String? // NIU
  tradeRegister         String? // RCCM
  address               String?
  phone                 String?
  email                 String?
  isDefault             Boolean         @default(false)
  accountingLevel       AccountingLevel @default(SIMPLE)
  fullSince             DateTime?       @db.Date // first day kept in Full accounting (the ledger starts from the first record)
  fiscalYearStartMonth  Int             @default(1)
  vatEnabled            Boolean         @default(false)
  vatSince              DateTime?       @db.Date
  vatPricesInclude      Boolean         @default(true) // prices and amounts typed include VAT
  vatRateBp             Int             @default(1925) // standard rate in basis points (19.25 %)
  vatExempt             String[]        @default([]) // money categories without VAT
  payablesEnabled       Boolean         @default(false)
  reconciliationEnabled Boolean         @default(false)
  approvalThreshold     Int             @default(0) // manual entries by a head above this amount need approval (0: all)
  accountMap            Json? // overrides of the default account of a money category or posting role
  departments           Department[]
  periods               AccountingPeriod[]
  ledgerAccounts        LedgerAccount[]
  journals              Journal[]
  entries               JournalEntry[]
  members               CompanyMember[]
  suppliers             Supplier[]
  supplierBills         SupplierBill[]
  bankStatements        BankStatement[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("companies")
}

/// An accountant's access to a company (the Boss sees every company).
model CompanyMember {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

/// The chart of accounts of a company (SYSCOHADA revised, seeded; sub-accounts may be added).
model LedgerAccount {
  id           String        @id @default(uuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number       String
  name         String // official name (French)
  label        String // English label shown in the app
  isActive     Boolean       @default(true)
  isSystem     Boolean       @default(false) // part of the seeded chart
  reconcilable Boolean       @default(false) // bank, MoMo, cash: matched against statements
  lines        JournalLine[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([companyId, number])
  @@map("ledger_accounts")
}

model Journal {
  id        String         @id @default(uuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String // VE, AC, CA, BQ, MM, OD, AN
  name      String
  kind      JournalKind
  entries   JournalEntry[]
  createdAt DateTime       @default(now())

  @@unique([companyId, code])
  @@map("journals")
}

/// One balanced entry. Generated entries carry the key of their source (a money record, an event
/// held, a month of rent …) and a fingerprint of their lines: when the source changes, the entry is
/// reversed and a new one posted. Posted entries are never updated (database trigger).
model JournalEntry {
  id             String             @id @default(uuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalId      String
  journal        Journal            @relation(fields: [journalId], references: [id], onDelete: Restrict)
  number         String? // "VE-2026-00042", given when posted
  date           DateTime           @db.Date
  label          String
  reference      String? // the source document number (S-0142, RC-0003 …)
  departmentId   String?
  sourceKey      String? // e.g. "tx:<id>", "venue-event:<bookingId>", "lease-rent:<leaseId>:2026-10"
  fingerprint    String?
  status         JournalEntryStatus @default(POSTED)
  isManual       Boolean            @default(false)
  late           Boolean            @default(false) // a change to a closed period, posted in the first open day
  reversalOfId   String?            @unique
  reversalOf     JournalEntry?      @relation("EntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     JournalEntry?      @relation("EntryReversal")
  reversedAt     DateTime?
  total          Int                @default(0)
  note           String?
  createdById    String?
  createdByName  String?
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?
  rejectedReason String?
  postedAt       DateTime?
  lines          JournalLine[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([companyId, sourceKey])
  @@index([companyId, status])
  @@index([journalId, date])
  @@map("journal_entries")
}

model JournalLine {
  id               String         @id @default(uuid())
  entryId          String
  entry            JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  companyId        String
  accountId        String
  account          LedgerAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  date             DateTime       @db.Date
  position         Int            @default(0)
  debit            Int            @default(0)
  credit           Int            @default(0)
  label            String?
  departmentId     String?
  partnerKey       String? // "debt:<id>", "booking:<id>", "stay:<id>", "order:<id>", "lease:<id>", "supplier:<id>" …
  partnerName      String?
  vatBase          Int? // VAT lines: the amount the VAT was computed on
  reconciliationId String? // lines matched together (a bank statement line, or a partner's invoice and payment)
  createdAt        DateTime       @default(now())

  @@index([entryId])
  @@index([companyId, accountId, date])
  @@index([companyId, partnerKey])
  @@index([companyId, departmentId, date])
  @@index([reconciliationId])
  @@map("journal_lines")
}

model Supplier {
  id         String         @id @default(uuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  taxId      String?
  address    String?
  isActive   Boolean        @default(true)
  bills      SupplierBill[]
  payments   Transaction[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([companyId, name])
  @@map("suppliers")
}

/// A supplier's invoice paid later: each line is an expense on credit of a department (counted on the
/// bill's date), payments are SUPPLIER_PAYMENT money records.
model SupplierBill {
  id           String             @id @default(uuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  departmentId String
  referenceNo  String // "FF-0001"
  supplierRef  String? // the supplier's invoice number
  date         DateTime           @db.Date
  dueDate      DateTime?          @db.Date
  total        Int
  taxAmount    Int                @default(0)
  paid         Int                @default(0)
  status       SupplierBillStatus @default(OPEN)
  note         String?
  voidReason   String?
  createdById  String
  records      Transaction[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([companyId, referenceNo])
  @@index([companyId, status])
  @@index([supplierId])
  @@map("supplier_bills")
}

/// A bank or MoMo statement imported for reconciliation.
model BankStatement {
  id             String          @id @default(uuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountNumber  String // ledger account reconciled (5211 bank, 552 MoMo …)
  name           String
  fromDate       DateTime        @db.Date
  toDate         DateTime        @db.Date
  openingBalance Int             @default(0)
  closingBalance Int             @default(0)
  importedById   String
  lines          StatementLine[]
  createdAt      DateTime        @default(now())

  @@index([companyId, accountNumber])
  @@map("bank_statements")
}

model StatementLine {
  id            String              @id @default(uuid())
  statementId   String
  statement     BankStatement       @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date          DateTime            @db.Date
  label         String
  reference     String?
  amount        Int // money in > 0, out < 0
  status        StatementLineStatus @default(UNMATCHED)
  journalLineId String?             @unique // the ledger line it matches
  entryId       String? // the entry created from it (fees, interest …)
  createdAt     DateTime            @default(now())

  @@index([statementId, status])
  @@map("statement_lines")
}


// ─── Sales & stock: shop, bar, other (lib/trade) ───────────────────────────────────────────
// docs/TRADE_AND_SERVICES_PLAN.md. A sale is a SALE money record; its lines and stock moves hang
// on it. Stock is valued at average cost; every movement carries its value.

enum TradeProductKind {
  GOODS // kept in stock
  SERVICE // sold without stock (a service, a fee)
}

enum TradeMovementKind {
  OPENING // counted when the product was added (an opening balance, not a purchase)
  PURCHASE
  SALE // sold, or served on an open tab
  RETURN // a sale voided or a line taken off a tab: back in stock
  COUNT // a physical count corrected the stock (signed)
  LOSS // broken, expired, stolen, given away
  PURCHASE_VOID // a purchase recorded by mistake leaves the stock again
}

enum TradeTabStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum PackagingMoveKind {
  RECEIVED // full crates in with a purchase: owed back to the supplier, deposit paid (or owed)
  RETURNED // empties given back to the supplier: deposit refunded (or set against a purchase)
  CUSTOMER_OUT // a customer takes bottles / crates away: deposit received
  CUSTOMER_BACK // the customer brings them back: deposit refunded
  BROKEN // broken or lost: their deposit is a cost
  COUNT // empties counted (signed correction of what is on hand)
}

model TradeProduct {
  id            String           @id @default(uuid())
  organizationId String
  departmentId  String
  department    Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code          String // "PR-0001"
  barcode       String?
  name          String
  category      String?
  unit          String           @default("piece")
  kind          TradeProductKind @default(GOODS)
  salePrice     Int
  costPrice     Int              @default(0) // average cost of one unit in stock
  quantity      Float            @default(0)
  lowStock      Float            @default(0)
  packagingId   String? // bar: the returnable crate a bottle comes in
  packaging     TradePackaging?  @relation(fields: [packagingId], references: [id], onDelete: SetNull)
  unitsPerPack  Int              @default(1) // bottles in a crate, pieces in a carton
  supplierName  String?
  isActive      Boolean          @default(true)
  createdById   String
  movements     TradeMovement[]
  saleLines     TradeSaleLine[]
  tabLines      TradeTabLine[]
  purchaseLines TradePurchaseLine[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([departmentId, code])
  @@unique([departmentId, barcode])
  @@index([departmentId, name])
  @@map("trade_products")
}

model TradeMovement {
  id            String            @id @default(uuid())
  departmentId  String
  department    Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  productId     String
  product       TradeProduct      @relation(fields: [productId], references: [id], onDelete: Restrict)
  kind          TradeMovementKind
  quantity      Float // signed: + in, − out
  unitCost      Int
  value         Int // signed value at cost (quantity × unit cost)
  date          DateTime
  transactionId String? // the sale
  tabLineId     String?
  purchaseId    String?
  note          String?
  createdById   String
  createdAt     DateTime          @default(now())

  @@index([departmentId, date])
  @@index([productId, date])
  @@index([transactionId])
  @@map("trade_movements")
}

/// One line of a sale (shop, bar, other): what was sold, at what price, at what cost.
model TradeSaleLine {
  id            String       @id @default(uuid())
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  departmentId  String
  productId     String
  product       TradeProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  name          String
  quantity      Float
  unitPrice     Int
  total         Int
  discount      Int          @default(0)
  unitCost      Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([transactionId])
  @@index([departmentId, productId])
  @@map("trade_sale_lines")
}

/// A bar tab: drinks served to a table or a customer, paid when it closes (one SALE).
model TradeTab {
  id            String         @id @default(uuid())
  departmentId  String
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  referenceNo   String // "TB-0001"
  label         String // table, customer
  status        TradeTabStatus @default(OPEN)
  openedAt      DateTime       @default(now())
  openedById    String
  closedAt      DateTime?
  cancelReason  String?
  transactionId String?        @unique
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  lines         TradeTabLine[]
  updatedAt     DateTime       @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([departmentId, status])
  @@map("trade_tabs")
}

model TradeTabLine {
  id         String       @id @default(uuid())
  tabId      String
  tab        TradeTab     @relation(fields: [tabId], references: [id], onDelete: Cascade)
  productId  String
  product    TradeProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  name       String
  quantity   Float
  unitPrice  Int
  total      Int
  addedAt    DateTime     @default(now())
  addedById  String
  voidedAt   DateTime?
  voidReason String?

  @@index([tabId])
  @@map("trade_tab_lines")
}

model TradePurchase {
  id            String              @id @default(uuid())
  departmentId  String
  department    Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  referenceNo   String // "PU-0001"
  supplierName  String
  supplierRef   String?
  date          DateTime
  goodsTotal    Int
  depositTotal  Int                 @default(0) // crates' deposits (bar): not a cost
  paymentMethod PaymentMethod
  supplierBillId String? // bought on credit: the bill in the company's books
  status        String              @default("RECORDED") // RECORDED | VOIDED
  voidReason    String?
  createdById   String
  lines         TradePurchaseLine[]
  records       Transaction[]
  createdAt     DateTime            @default(now())

  @@unique([departmentId, referenceNo])
  @@index([departmentId, date])
  @@map("trade_purchases")
}

model TradePurchaseLine {
  id         String        @id @default(uuid())
  purchaseId String
  purchase   TradePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    TradeProduct  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Float
  unitCost   Int
  total      Int

  @@index([purchaseId])
  @@map("trade_purchase_lines")
}

/// A returnable container (bar): a crate with its bottles, its deposit (consigne) per crate.
model TradePackaging {
  id           String              @id @default(uuid())
  departmentId String
  department   Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String // "SABC crate (12)"
  supplierName String?
  deposit      Int // deposit of one crate with its bottles
  bottleDeposit Int                @default(0) // deposit of one bottle (customers taking bottles)
  isActive     Boolean             @default(true)
  products     TradeProduct[]
  movements    PackagingMovement[]
  createdAt    DateTime            @default(now())

  @@unique([departmentId, name])
  @@map("trade_packagings")
}

model PackagingMovement {
  id            String            @id @default(uuid())
  departmentId  String
  packagingId   String
  packaging     TradePackaging    @relation(fields: [packagingId], references: [id], onDelete: Restrict)
  kind          PackagingMoveKind
  quantity      Int // crates (always > 0, except COUNT: signed)
  amount        Int               @default(0) // deposit paid, received or lost
  partyName     String? // the supplier or the customer
  transactionId String?
  transaction   Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  purchaseId    String?
  date          DateTime
  note          String?
  createdById   String
  voidedAt      DateTime?
  createdAt     DateTime          @default(now())

  @@index([departmentId, date])
  @@index([packagingId])
  @@map("packaging_movements")
}

// ─── Job tickets: pressing, car wash, other (lib/services) ─────────────────────────────────

enum ServiceTicketStatus {
  RECEIVED
  IN_PROGRESS
  READY
  COLLECTED
  CANCELLED
}

enum CommissionType {
  NONE
  PERCENT
  FIXED
}

/// A service of the price list, with its price for each variant (garment, vehicle type).
model ServiceItem {
  id              String         @id @default(uuid())
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name            String
  category        String?
  basePrice       Int            @default(0) // when a variant has no price of its own
  prices          Json? // price of each variant by name: Shirt 500, Suit 3000; Car 2000, 4x4 3000
  unit            String         @default("item") // item, kg, vehicle
  commissionType  CommissionType @default(NONE)
  commissionValue Int            @default(0) // % or FCFA per unit
  minutes         Int? // usual duration (car wash queue)
  sortOrder       Int            @default(0)
  isActive        Boolean        @default(true)
  lines           ServiceTicketLine[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([departmentId, name])
  @@map("service_items")
}

model ServiceWorker {
  id           String              @id @default(uuid())
  departmentId String
  department   Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  isActive     Boolean             @default(true)
  lines        ServiceTicketLine[]
  payouts      Transaction[]
  createdAt    DateTime            @default(now())

  @@unique([departmentId, name])
  @@map("service_workers")
}

model ServiceTicket {
  id            String              @id @default(uuid())
  organizationId String
  departmentId  String
  department    Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  referenceNo   String // "TK-0001"
  clientId      String?
  client        VenueClient?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  customerName  String?
  customerPhone String?
  vehiclePlate  String?
  vehicleType   String?
  status        ServiceTicketStatus @default(RECEIVED)
  express       Boolean             @default(false)
  surchargePct  Int                 @default(0)
  discount      Int                 @default(0)
  discountReason String?
  subtotal      Int                 @default(0)
  total         Int                 @default(0)
  tagNo         String? // pressing: tag numbers on the garments
  notes         String?
  receivedAt    DateTime
  promisedAt    DateTime?
  startedAt     DateTime?
  readyAt       DateTime?
  collectedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  notifiedAt    DateTime?
  createdById   String
  lines         ServiceTicketLine[]
  records       Transaction[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([departmentId, status])
  @@index([departmentId, receivedAt])
  @@index([departmentId, collectedAt])
  @@index([departmentId, vehiclePlate])
  @@map("service_tickets")
}

model ServiceTicketLine {
  id         String         @id @default(uuid())
  ticketId   String
  ticket     ServiceTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  itemId     String?
  item       ServiceItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  variant    String?
  label      String
  quantity   Float
  unitPrice  Int
  total      Int
  workerId   String?
  worker     ServiceWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  commission Int            @default(0) // earned by the worker (counted on collection)
  notes      String? // colour, brand, stains …
  position   Int            @default(0)

  @@index([ticketId])
  @@index([workerId])
  @@map("service_ticket_lines")
}

