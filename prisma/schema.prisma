generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared platform layer
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id                 String                @id @default(uuid())
  name               String
  slug               String                @unique
  currency           String                @default("FCFA")
  timezone           String                @default("Africa/Douala")
  departments        Department[]
  users              User[]
  accounts           Account[]
  transactions       Transaction[]
  dailyStockRecords  DailyStockRecord[]
  stockItems         DepartmentStockItem[]
  stockMovements     StockMovement[]
  menuItems          MenuItem[]
  saleLines          SaleLine[]
  debts              Debt[]
  debtPayments       DebtPayment[]
  cashHandovers      CashHandover[]
  cashRequests       CashRequest[]
  recipeIngredients  RecipeIngredient[]
  dailyReports       DailyReport[]
  purchases          Purchase[]
  auditEvents        AuditEvent[]
  attachments        Attachment[]
  accountingPeriods  AccountingPeriod[]
  inventorySnapshots InventorySnapshot[]
  debtors            Debtor[]
  notifications      Notification[]
  syncOperations     SyncOperation[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@map("organizations")
}

model Department {
  id                 String                @id @default(uuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  domain             DepartmentDomain      @default(RESTAURANT)
  code               String? // short code used in printed reference numbers, e.g. "RST"
  cashierDiscountLimit Int                 @default(0) // max discount (FCFA) a cashier may give per sale; 0 = not allowed
  openingCashFloat   Int                   @default(0) // cash in the drawer when the department started using the app
  isActive           Boolean               @default(true)
  debtors            Debtor[]
  documentSequences  DocumentSequence[]
  users              User[]                @relation("DepartmentUsers")
  memberships        UserDepartment[]
  accounts           Account[]
  transactions       Transaction[]
  dailyStockRecords  DailyStockRecord[]
  stockItems         DepartmentStockItem[]
  stockMovements     StockMovement[]
  menuItems          MenuItem[]
  saleLines          SaleLine[]
  debts              Debt[]
  debtPayments       DebtPayment[]
  cashHandovers      CashHandover[]
  cashRequests       CashRequest[]
  recipeIngredients  RecipeIngredient[]
  dailyReports       DailyReport[]
  purchases          Purchase[]
  attachments        Attachment[]
  inventorySnapshots InventorySnapshot[]
  venues             Venue[]
  venuePriceRules    VenuePriceRule[]
  venueClients       VenueClient[]
  venueBookings      VenueBooking[]
  venueCharges       VenueBookingCharge[]
  venuePackages      VenuePackage[]
  venueAssets        VenueAsset[]
  eventAssetChecks   EventAssetCheck[]
  assetIncidents     VenueAssetIncident[]
  venueLeads         VenueLead[]
  venueCashCounts    VenueCashCount[]
  rooms              Room[]
  roomBookings       RoomBooking[]
  roomAssets         RoomAsset[]
  roomAssetMoves     RoomAssetMovement[]
  roomRepairs        RoomRepair[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([organizationId])
  @@map("departments")
}

model User {
  id                String                @id @default(uuid())
  organizationId    String?
  organization      Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId      String? // Primary/default department (mirror of the primary membership)
  department        Department?           @relation("DepartmentUsers", fields: [departmentId], references: [id], onDelete: SetNull)
  email             String                @unique
  passwordHash      String                @default("")
  name              String
  phone             String?
  imageUrl          String?
  role              UserRole              @default(HEAD)
  title             String? // job title given by the Boss (e.g. "Accountant", "Manager"); the role stays Department head
  isActive          Boolean               @default(true)
  // Sign-in security: bumping sessionVersion signs every session out at once; a temporary
  // password set by the Boss must be changed at the first sign-in; wrong passwords lock the
  // account for a while (shared by every server instance, unlike an in-memory counter).
  sessionVersion     Int       @default(0)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  memberships       UserDepartment[]
  transactions      Transaction[]
  accounts          Account[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  dailyStockRecords DailyStockRecord[]
  stockItems        DepartmentStockItem[]
  stockMovements    StockMovement[]
  menuItems         MenuItem[]
  saleLines         SaleLine[]
  debts             Debt[]
  debtPayments      DebtPayment[]
  cashHandovers     CashHandover[]
  cashRequests      CashRequest[]  @relation("CashRequestRequestedBy")
  recipeIngredients RecipeIngredient[]
  purchases         Purchase[]
  attachments       Attachment[]
  submittedReports  DailyReport[]         @relation("ReportSubmittedBy")
  reviewedReports   DailyReport[]         @relation("ReportReviewedBy")
  bookingsHandled   VenueBooking[]        @relation("BookingHandledBy")
  bookingsCreated   VenueBooking[]        @relation("BookingCreatedBy")
  leadsHandled      VenueLead[]           @relation("LeadHandledBy")
  assetChecks       EventAssetCheck[]     @relation("AssetCheckedBy")
  roomBookingsMade  RoomBooking[]         @relation("RoomBookingCreatedBy")
  expensesValidated Transaction[]         @relation("ExpenseValidatedBy")
  roomAssetMoves    RoomAssetMovement[]   @relation("RoomAssetMovedBy")
  roomRepairsMade   RoomRepair[]          @relation("RoomRepairCreatedBy")
  cashCounts        VenueCashCount[]      @relation("CashCountedBy")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@map("users")
}

model UserDepartment {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isPrimary    Boolean    @default(false)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_departments")
}

/// Two roles: the Boss who created the business, and department heads (everyone the Boss adds;
/// they head every department they are assigned to). Job titles are free text (User.title).
enum UserRole {
  ADMIN // the Boss: oversees the business, manages departments and people
  HEAD // department head of one or more departments
}

enum DepartmentDomain {
  RESTAURANT
  EVENT_VENUE
  BAR
  PRESSING
  CAR_WASH
  ROOM_RENTAL
  MATERIAL_RENTAL
  SHOP
  OTHER
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique // SHA-256 of the refresh token (the token itself is only in the cookie)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AccountingPeriod {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime // inclusive, start of business day (UTC instant)
  endDate        DateTime // inclusive, end of business day (UTC instant)
  status         AccountingPeriodStatus @default(OPEN)
  closedById     String?
  closedAt       DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, startDate])
  @@index([organizationId, startDate, endDate])
  @@map("accounting_periods")
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

/// Accounts are cash drawers / MoMo wallets / bank accounts held by a department.
model Account {
  id             String         @id @default(uuid())
  name           String
  type           AccountType
  balance        Decimal        @default(0)
  isDefault      Boolean        @default(false)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  cashHandovers  CashHandover[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@map("accounts")
}

/// Shared financial event header. `type` is the single accounting classifier;
/// `category`/`operationCategory` are descriptive sub-categories only.
model Transaction {
  id                String             @id @default(uuid())
  type              TransactionType
  amount            Decimal
  grossAmount       Decimal?
  discountAmount    Decimal?           @default(0)
  netAmount         Decimal?
  paymentMethod     PaymentMethod      @default(CASH)
  customerName      String?
  counterparty      String? // tenant / income source / supplier / payee
  reference         String? // external reference typed by the user (receipt no., MoMo id)
  referenceNo       String? // internal document number, e.g. "S-0142" (unique per department)
  operationCategory OperationCategory?
  description       String?
  date              DateTime           @default(now())
  category          String
  receiptUrl        String?
  receivedByName    String? // who received the money (venue payments), when not the person recording it
  bookingId         String? // venue booking this payment, refund or event expense belongs to
  booking           VenueBooking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  stayId            String? // rooms: the stay this payment or refund belongs to
  stay              RoomBooking?       @relation(fields: [stayId], references: [id], onDelete: SetNull)
  roomId            String? // rooms: the apartment an expense or income belongs to (none: shared by the house)
  room              Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  authorizedByName  String? // who authorized the expense (as stated when recording it)
  validatedById     String? // who checked the expense afterwards (the Boss or another head)
  validatedBy       User?              @relation("ExpenseValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt       DateTime?
  validationNote    String?
  status            TransactionStatus  @default(COMPLETED)
  voidedAt          DateTime?
  voidedById        String?
  voidReason        String?
  idempotencyKey    String?
  organizationId    String?
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String?
  account           Account?           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stockMovements    StockMovement[]
  saleLines         SaleLine[]
  debt              Debt?
  debtPayment       DebtPayment?
  cashHandovers     CashHandover[]
  purchase          Purchase?

  @@unique([organizationId, idempotencyKey])
  @@unique([departmentId, referenceNo])
  @@index([organizationId])
  @@index([departmentId])
  @@index([departmentId, date])
  @@index([departmentId, type, date])
  @@index([userId])
  @@index([accountId])
  @@index([date])
  @@index([bookingId])
  @@index([stayId])
  @@index([roomId, date])
  @@map("transactions")
}

/// Legacy aggregate daily stock records (read-only history, superseded by stock movements).
model DailyStockRecord {
  id             String       @id @default(uuid())
  date           DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  openingStock   Decimal      @default(0)
  newPurchases   Decimal      @default(0)
  stockUsed      Decimal      @default(0)
  damagedStock   Decimal      @default(0)
  closingStock   Decimal      @default(0)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@index([userId])
  @@index([date])
  @@map("daily_stock_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// Restaurant inventory
// ─────────────────────────────────────────────────────────────────────────────

model DepartmentStockItem {
  id                 String              @id @default(uuid())
  name               String
  category           String?
  unit               String              @default("unit")
  trackingPeriod     StockTrackingPeriod @default(DAILY)
  openingQuantity    Decimal             @default(0)
  openingUnitCost    Decimal             @default(0)
  periodStart        DateTime?
  periodEnd          DateTime?
  currentQuantity    Decimal             @default(0)
  valuationUnitCost  Decimal             @default(0)
  reorderLevel       Decimal             @default(0)
  isActive           Boolean             @default(true)
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements          StockMovement[]
  recipeIngredients  RecipeIngredient[]
  purchaseLines      PurchaseLine[]
  inventorySnapshots InventorySnapshot[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([departmentId, name])
  @@index([organizationId])
  @@index([departmentId])
  @@map("department_stock_items")
}

/// Every change of plates in stock writes one movement (menuItemId). `quantity` is positive
/// for OPENING / STOCK_ADDED / SOLD / SPOILED and signed for CORRECTION /
/// OPENING_CORRECTION / REVERSAL. `balanceAfter` is the plates right after the movement.
/// stockItemId and the legacy types belong to the retired ingredient model (history only).
model StockMovement {
  id             String               @id @default(uuid())
  type           StockMovementType
  quantity       Decimal
  unitCost       Decimal?
  balanceAfter   Decimal?
  date           DateTime             @default(now())
  notes          String?
  reason         String?
  referenceNo    String? // "A-0012" stock added, "C-0003" correction / opening correction
  voidedAt       DateTime? // set on an addition that was voided (a REVERSAL movement compensates)
  purchaseId     String?
  purchase       Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  stockItemId    String?
  stockItem      DepartmentStockItem? @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem?            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  transactionId  String?
  transaction    Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())

  @@index([stockItemId, date])
  @@index([menuItemId, date])
  @@index([departmentId, date])
  @@map("stock_movements")
}

enum DishInventoryMode {
  DIRECT_PLATE
  RECIPE
}

/// A dish: one line of the menu AND one line of stock (plates). sellingPrice is the
/// "unit price"; currentQuantity caches the sum of the dish's stock movements.
model MenuItem {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  section            String?
  unit               String              @default("plate")
  sellingPrice       Decimal
  costPrice          Decimal             @default(0) // optional cost per plate (0 = unknown)
  inventoryMode      DishInventoryMode   @default(DIRECT_PLATE) // legacy; always DIRECT_PLATE
  openingQuantity    Decimal             @default(0) // legacy; opening is an OPENING movement
  currentQuantity    Decimal             @default(0)
  lowStockLevel      Int                 @default(0)
  sortOrder          Int                 @default(0)
  isActive           Boolean             @default(true)
  archivedAt         DateTime?
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe             RecipeIngredient[]
  saleLines          SaleLine[]
  purchaseLines      PurchaseLine[]
  movements          StockMovement[]
  inventorySnapshots InventorySnapshot[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([departmentId, name])
  @@index([organizationId, departmentId])
  @@map("menu_items")
}

model RecipeIngredient {
  id             String              @id @default(uuid())
  quantity       Decimal
  menuItemId     String
  menuItem       MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItemId    String
  stockItem      DepartmentStockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, stockItemId])
  @@index([departmentId])
  @@map("recipe_ingredients")
}

/// Sale line with price/cost snapshots so later menu edits never rewrite history.
model SaleLine {
  id             String            @id @default(uuid())
  quantity       Decimal
  unitPrice      Decimal
  totalAmount    Decimal // gross line value
  discountAmount Decimal           @default(0)
  netAmount      Decimal           @default(0)
  unitCost       Decimal           @default(0) // cost of one unit at time of sale (COGS)
  inventoryMode  DishInventoryMode @default(DIRECT_PLATE)
  transactionId  String
  transaction    Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@index([transactionId])
  @@index([menuItemId, createdAt])
  @@map("sale_lines")
}

model Purchase {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierName   String?
  reference      String?
  paymentMethod  PaymentMethod  @default(CASH)
  totalAmount    Decimal
  date           DateTime       @default(now())
  receiptUrl     String?
  notes          String?
  status         PurchaseStatus @default(RECORDED)
  transactionId  String?        @unique
  transaction    Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  lines          PurchaseLine[]
  stockAdds      StockMovement[] // plates this purchase added to dishes
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, departmentId, date])
  @@map("purchases")
}

enum PurchaseStatus {
  RECORDED
  VOIDED
}

model PurchaseLine {
  id          String               @id @default(uuid())
  purchaseId  String
  purchase    Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  description String? // what was bought, e.g. "Fish 10 kg"
  stockItemId String?
  stockItem   DepartmentStockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  menuItemId  String?
  menuItem    MenuItem?            @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  quantity    Decimal
  unitCost    Decimal
  totalCost   Decimal
  createdAt   DateTime             @default(now())

  @@index([purchaseId])
  @@map("purchase_lines")
}

// ─────────────────────────────────────────────────────────────────────────────
// Receivables, cash handovers, reports, audit
// ─────────────────────────────────────────────────────────────────────────────

/// Money a customer owes the department. CREDIT_SALE / MANUAL debts come with a credit
/// sale (revenue on the day); OPENING_BALANCE debts existed before the app (no revenue).
model Debt {
  id              String        @id @default(uuid())
  source          DebtSource    @default(CREDIT_SALE)
  referenceNo     String? // "D-0007"
  debtorId        String?
  debtor          Debtor?       @relation(fields: [debtorId], references: [id], onDelete: SetNull)
  debtorName      String
  debtorContact   String?
  foodDescription String? // description of what was taken
  dueDate         DateTime?
  voidedAt        DateTime?
  voidReason      String?
  amountOwed      Decimal
  amountPaid      Decimal       @default(0)
  status          DebtStatus    @default(UNPAID)
  date            DateTime      @default(now())
  transactionId   String?       @unique
  transaction     Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments        DebtPayment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, departmentId, status])
  @@index([departmentId, date])
  @@index([debtorId])
  @@map("debts")
}

enum DebtSource {
  CREDIT_SALE
  MANUAL
  OPENING_BALANCE
}

/// Customer directory per department (people who take food on credit).
model Debtor {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  notes          String?
  isActive       Boolean      @default(true)
  debts          Debt[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([departmentId, name])
  @@map("debtors")
}

/// Counters for human-readable document numbers ("S-0142"), per department and type.
/// docType: S sale, P purchase, E expense, X other expense, R rent income, I other income,
/// K discount, D debt, Y debt repayment, H cash handover, A stock added, C stock correction,
/// DR daily report.
model DocumentSequence {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  docType      String
  nextValue    Int        @default(1)

  @@unique([departmentId, docType])
  @@map("document_sequences")
}

/// In-app notifications (Boss: report sent, handover recorded; head: report returned …).
model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId   String?
  kind           String
  title          String
  body           String?
  href           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model DebtPayment {
  id             String        @id @default(uuid())
  amount         Decimal
  paymentMethod  PaymentMethod @default(CASH)
  reference      String?
  date           DateTime      @default(now())
  voidedAt       DateTime?
  debtId         String
  debt           Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transactionId  String?       @unique
  transaction    Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([debtId, date])
  @@index([departmentId, date])
  @@map("debt_payments")
}

model CashHandover {
  id             String         @id @default(uuid())
  amount         Decimal
  recipientName  String         @default("CEO")
  referenceNo    String? // "H-0031"
  reference      String?
  receiptUrl     String?
  status         HandoverStatus @default(RECORDED)
  confirmedById  String?
  confirmedAt    DateTime?
  reviewNote     String?
  date           DateTime       @default(now())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String?
  account        Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactionId  String?
  transaction    Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  cashRequestId  String? // the Boss's request this handover answers
  cashRequest    CashRequest?   @relation(fields: [cashRequestId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@index([organizationId, departmentId, date])
  @@index([organizationId, status])
  @@map("cash_handovers")
}

/// The Boss asks a department to hand over the cash of a period (default: one day).
model CashRequest {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User              @relation("CashRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  fromKey        String // business days "YYYY-MM-DD", inclusive
  toKey          String
  note           String?
  status         CashRequestStatus @default(OPEN)
  answeredAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  handovers      CashHandover[]

  @@index([organizationId, status])
  @@index([departmentId, status])
  @@map("cash_requests")
}

enum CashRequestStatus {
  OPEN // waiting for the department head
  ANSWERED // the head handed cash over against it
  CANCELLED // withdrawn by the Boss
}

enum HandoverStatus {
  RECORDED // handed over by the department, awaiting the boss's confirmation
  CONFIRMED // boss confirmed receipt
  DISPUTED // boss disputes the amount (excluded from actual handover)
  VOIDED
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
  RETURNED
}

model DailyReport {
  id                 String              @id @default(uuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  reportDate         DateTime
  status             DailyReportStatus   @default(DRAFT)
  referenceNo        String? // "DR-0269"
  schemaVersion      Int                 @default(1) // snapshot layout version (2 = restaurant v2)
  version            Int                 @default(1)
  submittedById      String?
  submittedBy        User?               @relation("ReportSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById       String?
  reviewedBy         User?               @relation("ReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  snapshotJson       Json
  totalsJson         Json
  notes              String?
  reviewNotes        String?
  inventorySnapshots InventorySnapshot[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([departmentId, reportDate])
  @@index([organizationId, reportDate])
  @@index([organizationId, status])
  @@map("daily_reports")
}

/// Per-item closing position captured when a daily report is submitted.
model InventorySnapshot {
  id               String               @id @default(uuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId     String
  department       Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  dailyReportId    String
  dailyReport      DailyReport          @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  snapshotDate     DateTime
  itemType         InventoryItemType
  stockItemId      String?
  stockItem        DepartmentStockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  menuItemId       String?
  menuItem         MenuItem?            @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name             String
  unit             String
  openingQuantity  Decimal
  addedQuantity    Decimal
  usedQuantity     Decimal
  wastedQuantity   Decimal
  adjustedQuantity Decimal
  closingQuantity  Decimal
  unitCost         Decimal
  closingValue     Decimal
  createdAt        DateTime             @default(now())

  @@index([departmentId, snapshotDate])
  @@index([dailyReportId])
  @@map("inventory_snapshots")
}

enum InventoryItemType {
  STOCK_ITEM
  DISH
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  userId         String?
  action         String
  entityType     String
  entityId       String
  beforeJson     Json?
  afterJson      Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

/// Proof files (receipts, handover slips). Stored in the database so access is always
/// checked against organization/department membership.
model Attachment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  entityType     String?
  entityId       String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  data           Bytes
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
  @@map("attachments")
}


enum TransactionType {
  INCOME // legacy generic income (backfilled to OTHER_INCOME)
  EXPENSE
  SALE
  PURCHASE
  DISCOUNT
  RENT_INCOME
  OTHER_INCOME
  DEBT_PAYMENT
  OTHER_EXPENSE
  CASH_HANDOVER
  BOOKING_PAYMENT // money received from a client for a venue booking (an advance until the event)
  BOOKING_REFUND // money given back to a client of a venue booking
}

enum PaymentMethod {
  CASH
  CREDIT
  MOMO
  BANK_TRANSFER
}

enum OperationCategory {
  PURCHASE_FOOD
  PURCHASE_DRINK
  PURCHASE_SUPPLIES
  PURCHASE_STOCK
  OPEX_UTILITIES
  OPEX_TRANSPORT
  OPEX_MAINTENANCE
  OPEX_SALARIES
  OPEX_OTHER
  SALE_FOOD
  SALE_DRINK
  SALE_SERVICES
  RENT_INCOME
  OTHER_INCOME
  OTHER_EXPENSE
  DISCOUNT_PROMO
  DISCOUNT_STAFF
  DISCOUNT_CUSTOMER
  CASH_HANDOVER
  DEBT_COLLECTION
}

enum AccountType {
  CURRENT
  SAVINGS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  VOIDED
}


enum StockTrackingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum StockMovementType {
  OPENING // plates when a dish is created
  PURCHASE // legacy (ingredient model)
  PREPARATION // legacy: prepared plates added to a dish
  USAGE // legacy: sold / consumed
  DAMAGE // legacy
  WASTE // legacy
  ADJUSTMENT // legacy: signed correction after a count
  REVERSAL // signed reversal of a voided sale / addition
  STOCK_ADDED // plates added (prepared / bought ready / received)
  SOLD // plates sold (sale)
  SPOILED // plates thrown away
  CORRECTION // signed correction after a physical count
  OPENING_CORRECTION // signed; dated at the start of a day; corrects that day's opening
}

enum DebtStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// One write sent by a device, online or later from its offline outbox (lib/sync). The key
/// (generated on the device) makes every operation idempotent: a retried or replayed operation
/// returns the result of its first run instead of recording anything twice. Written in the same
/// database transaction as the operation itself.
model SyncOperation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  userId         String
  key            String
  kind           String
  result         Json
  occurredAt     DateTime // when it was done on the device
  appliedAt      DateTime     @default(now())

  @@unique([organizationId, key])
  @@index([departmentId, appliedAt])
  @@map("sync_operations")
}

// ─── Event venue / banquet hall (docs/VENUE_RENTAL_PLAN.md) ──────────────────
// Amounts are whole FCFA. Dates of events, seasons and follow-ups are calendar dates (DATE),
// in the organization's time zone. Every row carries organizationId for tenant scoping.

/// A hall of an event venue department (one to start; ready for several).
model Venue {
  id                  String           @id @default(uuid())
  organizationId      String
  departmentId        String
  department          Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  capacity            Int? // guests
  basePrice           Int              @default(0) // price of a date when no rule applies
  reservationHoldDays Int              @default(7) // a reservation without deposit is held this many days
  isActive            Boolean          @default(true)
  priceRules          VenuePriceRule[]
  bookings            VenueBooking[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([departmentId, name])
  @@index([organizationId])
  @@map("venues")
}

enum VenuePriceRuleKind {
  WEEKDAY // a day of the week (0 = Sunday … 6 = Saturday)
  SEASON // a date range (e.g. December holidays)
  SPECIAL_DATE // one date (e.g. 31 December)
}

/// Price of a date: special date > season > weekday > the hall's base price.
model VenuePriceRule {
  id             String             @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  venueId        String
  venue          Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  kind           VenuePriceRuleKind
  label          String?
  weekday        Int?
  startDate      DateTime?          @db.Date
  endDate        DateTime?          @db.Date
  price          Int
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([venueId, kind])
  @@map("venue_price_rules")
}

model VenueClient {
  id             String         @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  phoneAlt       String?
  email          String?
  company        String?
  notes          String?
  bookings       VenueBooking[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([departmentId, name])
  @@index([organizationId])
  @@map("venue_clients")
}

enum VenueBookingStatus {
  RESERVED // the date is held (until holdUntil unless a deposit is paid)
  CONFIRMED
  COMPLETED // the event took place: its price is revenue of the event date
  CANCELLED // frees the date
}

/// One event on one date of a hall. No two active bookings share a hall and a date (a partial
/// unique index in the migration: status <> CANCELLED).
model VenueBooking {
  id              String               @id @default(uuid())
  organizationId  String
  departmentId    String
  department      Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  venueId         String
  venue           Venue                @relation(fields: [venueId], references: [id], onDelete: Restrict)
  clientId        String
  client          VenueClient          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  referenceNo     String // "B-0001"
  eventType       String
  eventDate       DateTime             @db.Date
  startTime       String? // "14:00" (information)
  endTime         String?
  guests          Int?
  status          VenueBookingStatus   @default(RESERVED)
  hallPrice       Int // price of the date from the price rules when booked
  packageId       String?
  package         VenuePackage?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageSnapshot Json? // the package as sold: name, price, items
  packagePrice    Int                  @default(0)
  agreedPrice     Int // total agreed with the client (hall + package)
  priceNote       String? // why the agreed price differs from hall + package
  holdUntil       DateTime?            @db.Date // reserved without deposit: held until this date
  bookedAt        DateTime             @default(now())
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?
  leadId          String?              @unique
  lead            VenueLead?           @relation("LeadBooking", fields: [leadId], references: [id], onDelete: SetNull)
  handledById     String?
  handledBy       User?                @relation("BookingHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User                 @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions    Transaction[]
  charges         VenueBookingCharge[]
  assetChecks     EventAssetCheck[]
  incidents       VenueAssetIncident[]
  roomBookings    RoomBooking[]        @relation("PackageRooms")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([departmentId, eventDate])
  @@index([departmentId, status, eventDate])
  @@index([organizationId, eventDate])
  @@index([clientId])
  @@map("venue_bookings")
}

enum VenueChargeKind {
  DAMAGE // damaged or missing assets charged to the client
  EXTRA_SERVICE
  OTHER
}

/// An amount added to what a client owes for a booking (damages, extra services).
model VenueBookingCharge {
  id             String              @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        VenueBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  referenceNo    String // "CH-0001"
  kind           VenueChargeKind
  label          String
  amount         Int
  date           DateTime            @default(now())
  createdById    String
  voidedAt       DateTime?
  voidReason     String?
  incident       VenueAssetIncident?
  createdAt      DateTime            @default(now())

  @@unique([departmentId, referenceNo])
  @@index([bookingId])
  @@index([departmentId, date])
  @@map("venue_booking_charges")
}

model VenuePackage {
  id             String             @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          Int // added to the hall price
  isActive       Boolean            @default(true)
  archivedAt     DateTime?
  items          VenuePackageItem[]
  bookings       VenueBooking[]
  leads          VenueLead[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([departmentId, isActive])
  @@map("venue_packages")
}

enum VenuePackageItemKind {
  ROOM // rooms of a rooms department (e.g. Executive Stay): quantity rooms × nights
  SERVICE // decoration, sound, catering …
  OTHER
}

model VenuePackageItem {
  id        String               @id @default(uuid())
  packageId String
  package   VenuePackage         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  kind      VenuePackageItemKind
  label     String
  quantity  Int                  @default(1)
  nights    Int?
  sortOrder Int                  @default(0)

  @@index([packageId])
  @@map("venue_package_items")
}

enum VenueAssetCategory {
  CHAIRS
  TABLES
  DECORATION
  SOUND
  LIGHTING
  FURNITURE
  OTHER
}

/// Hall inventory checked before and after every event.
model VenueAsset {
  id             String                @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  category       VenueAssetCategory
  quantity       Int // owned, in good condition or not
  unitValue      Int                   @default(0) // replacement value of one unit
  notes          String?
  isActive       Boolean               @default(true)
  checkLines     EventAssetCheckLine[]
  incidents      VenueAssetIncident[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([departmentId, name])
  @@index([organizationId])
  @@map("venue_assets")
}

enum EventCheckPhase {
  BEFORE
  AFTER
}

model EventAssetCheck {
  id             String                @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        VenueBooking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  phase          EventCheckPhase
  checkedById    String
  checkedBy      User                  @relation("AssetCheckedBy", fields: [checkedById], references: [id], onDelete: Restrict)
  checkedAt      DateTime              @default(now())
  notes          String?
  lines          EventAssetCheckLine[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([bookingId, phase])
  @@index([departmentId, checkedAt])
  @@map("event_asset_checks")
}

/// Per asset: units present in good condition, damaged, missing (good + damaged + missing = expected).
model EventAssetCheckLine {
  id       String          @id @default(uuid())
  checkId  String
  check    EventAssetCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  assetId  String
  asset    VenueAsset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  expected Int
  good     Int
  damaged  Int             @default(0)
  missing  Int             @default(0)
  note     String?

  @@unique([checkId, assetId])
  @@map("event_asset_check_lines")
}

enum AssetIncidentKind {
  DAMAGED
  MISSING
}

enum AssetResponsibility {
  CLIENT
  STAFF
  UNKNOWN
}

enum AssetIncidentStatus {
  OPEN // found after the event, not settled yet
  CHARGED // charged to the client (a booking charge)
  LOSS // recorded as a loss of the hall
  RESOLVED // repaired / found / replaced at no cost
}

/// A difference found after an event (damaged or missing units) and how it was settled.
model VenueAssetIncident {
  id             String              @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        VenueBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assetId        String
  asset          VenueAsset          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  kind           AssetIncidentKind
  quantity       Int
  cost           Int                 @default(0) // estimated cost (repair or replacement)
  responsibility AssetResponsibility @default(UNKNOWN)
  status         AssetIncidentStatus @default(OPEN)
  chargeId       String?             @unique
  charge         VenueBookingCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  note           String?
  settledAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([departmentId, status])
  @@index([bookingId])
  @@map("venue_asset_incidents")
}

enum VenueLeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  NEGOTIATING
  BOOKED
  LOST
  CANCELLED
}

/// An enquiry that is not (yet) a booking.
model VenueLead {
  id             String          @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  clientName     String
  phone          String?
  email          String?
  enquiryDate    DateTime        @db.Date
  proposedDate   DateTime?       @db.Date
  eventType      String?
  guests         Int?
  packageId      String?
  package        VenuePackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  priceDiscussed Int?
  source         String?
  handledById    String?
  handledBy      User?           @relation("LeadHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  followUpDate   DateTime?       @db.Date
  status         VenueLeadStatus @default(NEW)
  closedReason   String? // why it was lost or cancelled
  closedAt       DateTime?
  notes          String?
  booking        VenueBooking?   @relation("LeadBooking")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([departmentId, status])
  @@index([departmentId, followUpDate])
  @@index([departmentId, enquiryDate])
  @@map("venue_leads")
}

/// The cash counted in an event venue's drawer on a day, against what it should hold (the
/// difference is a discrepancy shown in the reports and to the Boss). One count per day; a
/// later count of the same day replaces it.
model VenueCashCount {
  id             String     @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  date           DateTime   @db.Date
  countedCash    Int
  expectedCash   Int // what the drawer should hold at the count (opening + cash in − cash out − handed over)
  variance       Int // counted − expected (negative: cash missing)
  notes          String?
  countedById    String
  countedBy      User       @relation("CashCountedBy", fields: [countedById], references: [id], onDelete: Restrict)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([departmentId, date])
  @@index([organizationId, date])
  @@map("venue_cash_counts")
}

// ─── Rooms / guest house (e.g. Executive Stay) ───────────────────────────────

/// A room of a rooms department.
model Room {
  id             String        @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String // number or name, e.g. "101" or "Executive suite 2"
  roomType       String?
  capacity       Int?
  nightlyRate    Int           @default(0)
  weeklyRate     Int? // suggested price of 7 nights (prices stay editable on each booking)
  monthlyRate    Int? // suggested price of 30 nights
  description    String?
  state          RoomState     @default(AVAILABLE) // set by the head; reserved / occupied come from the bookings
  stateNote      String?
  notes          String?
  isActive       Boolean       @default(true)
  bookings       RoomBooking[]
  transactions   Transaction[]
  assets         RoomAsset[]
  repairs        RoomRepair[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([departmentId, name])
  @@index([organizationId])
  @@map("rooms")
}

enum RoomState {
  AVAILABLE
  MAINTENANCE
  UNAVAILABLE
}

enum RoomBookingStatus {
  RESERVED
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

/// A stay in a room: nights from checkIn (included) to checkOut (excluded). No two stays of a
/// room overlap (checked under a lock per room). A free room of a venue package is a stay with
/// complimentary = true and the venue booking it comes from.
model RoomBooking {
  id                    String            @id @default(uuid())
  organizationId        String
  departmentId          String
  department            Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roomId                String
  room                  Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  referenceNo           String // "RB-0001"
  guestName             String
  guestPhone            String?
  guestEmail            String?
  guestCount            Int?
  bookingType           String            @default("NIGHT") // NIGHT | WEEK | MONTH | OTHER (how it was priced)
  priceNote             String? // why the price differs from the apartment's rate
  checkedInAt           DateTime?
  checkedOutAt          DateTime?
  checkIn               DateTime          @db.Date
  checkOut              DateTime          @db.Date
  status                RoomBookingStatus @default(CONFIRMED)
  nightlyRate           Int               @default(0)
  totalPrice            Int               @default(0)
  complimentary         Boolean           @default(false)
  sourceVenueBookingId  String?
  sourceVenueBooking    VenueBooking?     @relation("PackageRooms", fields: [sourceVenueBookingId], references: [id], onDelete: SetNull)
  notes                 String?
  cancelledAt           DateTime?
  cancelReason          String?
  createdById           String
  createdBy             User              @relation("RoomBookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions          Transaction[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([roomId, checkIn])
  @@index([departmentId, checkIn])
  @@index([sourceVenueBookingId])
  @@map("room_bookings")
}

/// An asset of a rooms department: a line per apartment (roomId) or in storage (no room). `damaged`
/// of the `quantity` units are damaged. Values are purchase values (no depreciation, owner's decision).
model RoomAsset {
  id             String              @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  name           String
  category       String // BED, MATTRESS, TV, FRIDGE, AC, CHAIR, TABLE, CURTAINS, KITCHEN, BATHROOM, FURNITURE, OTHER
  quantity       Int
  damaged        Int                 @default(0)
  unitValue      Int                 @default(0)
  notes          String?
  movements      RoomAssetMovement[]
  repairs        RoomRepair[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([departmentId, roomId])
  @@map("room_assets")
}

enum RoomAssetMovementKind {
  BOUGHT
  TRANSFER_OUT
  TRANSFER_IN
  DAMAGED
  MISSING
  REPAIRED
  REPLACED
  REMOVED
}

/// What happened to an asset line (each movement changes its counts in the same transaction).
/// `loss` is the value that left the register (missing, removed, replaced units).
model RoomAssetMovement {
  id             String                @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assetId        String
  asset          RoomAsset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  referenceNo    String // "AM-0001"
  kind           RoomAssetMovementKind
  quantity       Int
  value          Int                   @default(0) // value bought / moved
  loss           Int                   @default(0)
  cost           Int                   @default(0) // money spent (purchase, repair)
  otherRoomId    String? // transfer: the apartment on the other side
  transactionId  String? // when paid from the cash drawer
  note           String?
  date           DateTime
  createdById    String
  createdBy      User                  @relation("RoomAssetMovedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime              @default(now())

  @@unique([departmentId, referenceNo])
  @@index([departmentId, date])
  @@index([assetId])
  @@map("room_asset_movements")
}

enum RepairPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RepairStatus {
  REPORTED
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Something to fix in an apartment. Its actual cost, when paid from the cash drawer, is an
/// expense of the apartment (transactionId).
model RoomRepair {
  id             String         @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assetId        String?
  asset          RoomAsset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  referenceNo    String // "MR-0001"
  title          String
  description    String?
  reportedOn     DateTime       @db.Date
  priority       RepairPriority @default(NORMAL)
  status         RepairStatus   @default(REPORTED)
  estimatedCost  Int?
  actualCost     Int?
  responsibleName String?
  repairedOn     DateTime?      @db.Date
  transactionId  String?
  blocksRoom     Boolean        @default(false) // the apartment cannot be let until it is repaired
  cancelReason   String?
  createdById    String
  createdBy      User           @relation("RoomRepairCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([departmentId, referenceNo])
  @@index([departmentId, status])
  @@index([roomId])
  @@map("room_repairs")
}
