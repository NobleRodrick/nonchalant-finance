{
  "name": "springer-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "next build --webpack && next start",
    "lint": "eslint",
    "email": "email dev",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:offline": "next build --webpack && playwright test -c playwright.offline.config.mjs",
    "db:check": "node scripts/check-schema-drift.mjs",
    "test:load:seed": "vitest run --config tests/load/vitest.config.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:load:verify": "vitest run --config tests/load/vitest.verify.config.mjs",
    "test:isolation": "node scripts/test-isolation.mjs"
  },
  "dependencies": {
    "@arcjet/next": "^1.13.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "inngest": "^3.45.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.553.0",
    "next": "^16.2.10",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.2.0",
    "resend": "^6.5.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@react-email/preview-server": "^5.0.4",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "prisma": "^6.19.0",
    "react-email": "5.0.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vitest": "^3.2.7"
  }
}
