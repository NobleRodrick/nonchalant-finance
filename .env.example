# ── Required ────────────────────────────────────────────────────────────────
# Supabase: pooled connection for the app, direct connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Signs session tokens. At least 32 random characters. The app refuses to start in
# production without it. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# ── Optional features ───────────────────────────────────────────────────────
GEMINI_API_KEY=""          # AI receipt scanning and AI insights
GEMINI_MODEL="gemini-flash-lite-latest"
RESEND_API_KEY=""          # e-mails (missing-report reminder, monthly statement)
EMAIL_FROM="Springer Finance <onboarding@resend.dev>"
INNGEST_EVENT_KEY=""       # scheduled jobs
INNGEST_SIGNING_KEY=""

# Abuse protection (production): sign-in / registration / password rate limits, bot blocking,
# attack shield and disposable-e-mail check. Leave empty in development (an in-memory limiter is used).
ARCJET_KEY=""
# Set to DRY_RUN to only log what Arcjet would block.
ARCJET_MODE="LIVE"
NEXT_PUBLIC_APP_URL=""     # used for links inside e-mails, e.g. https://your-app.vercel.app

# ── Development / testing only ─────────────────────────────────────────────
# ALLOW_DEMO_SEED="true"   # enables POST /api/seed (never in production)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/springer_test"  # DISPOSABLE db for tests
# PRISMA_DRIVER_ADAPTER="pg"  # optional: use the node-postgres driver adapter
